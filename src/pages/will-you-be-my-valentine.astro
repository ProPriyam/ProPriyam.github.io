    // ============================================
    // INPUT HANDLING
    // ============================================
    document.addEventListener('keydown', (e) => {
      if (Game.state === 'story') {
        if (e.code === 'Space' || e.code === 'Enter') {
          advanceStory();
          e.preventDefault();
        }
        return;
      }
      
      if (Game.state === 'playing') {
        // Game over retry for teddy level
        if (Teddy.active && Teddy.playerDead && Teddy.deathTimer > 60) {
          if (e.code === 'Space' || e.code === 'Enter') {
            initTeddy();
            e.preventDefault();
          }
          return;
        }
        
        // Runner mode: left/right switch lanes, no jump needed
        if (Runner.active) {
          switch(e.code) {
            case 'ArrowLeft':
            case 'KeyA':
              if (Runner.lane > 0) Runner.lane--;
              e.preventDefault();
              break;
            case 'ArrowRight':
            case 'KeyD':
              if (Runner.lane < 2) Runner.lane++;
              e.preventDefault();
              break;
          }
          return;
        }
        
        switch(e.code) {
          case 'ArrowLeft':
          case 'KeyA':
            Game.keys.left = true;
            e.preventDefault();
            break;
          case 'ArrowRight':
          case 'KeyD':
            Game.keys.right = true;
            e.preventDefault();
            break;
          case 'ArrowUp':
          case 'KeyW':
          case 'Space':
            Game.keys.jump = true;
            e.preventDefault();
            break;
        }
      }
    });

    document.addEventListener('keyup', (e) => {
      switch(e.code) {
        case 'ArrowLeft':
        case 'KeyA':
          Game.keys.left = false;
          break;
        case 'ArrowRight':
        case 'KeyD':
          Game.keys.right = false;
          break;
        case 'ArrowUp':
        case 'KeyW':
        case 'Space':
          Game.keys.jump = false;
          break;
      }
    });

    document.getElementById('story-box').addEventListener('click', () => {
      if (Game.state === 'story') {
        advanceStory();
      }
    });

    document.getElementById('start-btn').addEventListener('click', () => {
      initAudio();
      document.getElementById('title-screen').style.display = 'none';
      loadLevel(0);
    });

    document.getElementById('eat-choco-btn').addEventListener('click', () => {
      eatChocolate();
    });

    document.getElementById('continue-to-teddy-btn').addEventListener('click', () => {
      continueTeddyLevel();
    });

    document.getElementById('teddy-continue-btn').addEventListener('click', () => {
      showItsADate();
    });

    // ============================================
    // MAIN GAME LOOP
    // ============================================
    function gameLoop() {
      // Clear canvas
      ctx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      
      if (Game.state === 'playing') {
        if (Runner.active) {
          updateRunner();
        } else if (Choco.active) {
          updateChocolate();
        } else if (Teddy.active) {
          updateTeddy();
        } else {
          updatePlayer();
          checkCollisions();
        }
        maybeShowPopup();
      }
      
      // Render
      if (Game.state === 'playing' || Game.state === 'story') {
        if (Runner.active) {
          drawRunner();
        } else if (Choco.active) {
          drawChocolate();
        } else if (Teddy.active) {
          drawTeddy();
        } else if (levels[Game.currentLevel] && levels[Game.currentLevel].isRunner) {
          // Story screen for runner level - show garden bg
          if (gardenBgImg.complete && gardenBgImg.naturalWidth > 0) {
            ctx.drawImage(gardenBgImg, 0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
          } else {
            const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
            grad.addColorStop(0, '#FFB3C6');
            grad.addColorStop(0.5, '#FFC8DD');
            grad.addColorStop(1, '#FFECF1');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
          }
        } else if (levels[Game.currentLevel] && levels[Game.currentLevel].isChocolate) {
          // Story screen for chocolate level - show chocolate bg
          const chocoGrad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
          chocoGrad.addColorStop(0, '#4A2C2A');
          chocoGrad.addColorStop(0.5, '#6B3A2E');
          chocoGrad.addColorStop(1, '#D2A679');
          ctx.fillStyle = chocoGrad;
          ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        } else if (levels[Game.currentLevel] && levels[Game.currentLevel].isTeddy) {
          // Story screen for teddy level - show cozy bedroom bg
          const teddyGrad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
          teddyGrad.addColorStop(0, '#FFF5E6');
          teddyGrad.addColorStop(1, '#FFE4C4');
          ctx.fillStyle = teddyGrad;
          ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        } else {
          drawBackground(Game.currentLevel);
          drawPlatforms();
          drawHearts();
          drawObstacles();
          drawPlayer();
          drawParticles();
        }
      } else if (Game.state === 'title') {
        // Animated title background
        const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
        grad.addColorStop(0, '#1A1A2E');
        grad.addColorStop(1, '#2D1B4E');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        
        // Floating hearts
        ctx.fillStyle = '#FF6B9D';
        for (let i = 0; i < 10; i++) {
          const hx = 50 + i * 80;
          const hy = 100 + Math.sin(Date.now() / 1000 + i) * 30;
          drawHeart(hx, hy, 10 + i % 3 * 5);
        }
      } else if (Game.state === 'victory') {
        // Victory background
        const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
        grad.addColorStop(0, '#FFF0F5');
        grad.addColorStop(1, '#FFE4EC');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        
        updateConfetti();
      } else if (Game.state === 'teddyVictory') {
        // Teddy victory background - warm pink
        const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
        grad.addColorStop(0, '#FFE4EC');
        grad.addColorStop(1, '#FFB6C1');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        
        updateConfetti();
      }
      
      requestAnimationFrame(gameLoop);
    }

    // Start the game loop
    gameLoop();
  </script>
</body>
</html>
