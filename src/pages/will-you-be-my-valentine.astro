---
// No layout - this is a standalone game page
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Finding My Valentine.exe</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #1a1a2e;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
      overflow: hidden;
    }

    #game-container {
      position: relative;
      width: 800px;
      max-width: 100vw;
      aspect-ratio: 800 / 500;
    }

    #gameCanvas {
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      border: 4px solid #FF6B9D;
      border-radius: 8px;
      box-shadow: 0 0 30px rgba(255, 107, 157, 0.3);
    }

    #ui-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .story-box {
      background: rgba(0, 0, 0, 0.85);
      border: 3px solid #FF6B9D;
      border-radius: 8px;
      padding: 20px 30px;
      max-width: 80%;
      text-align: center;
      pointer-events: auto;
      display: none;
    }

    .story-text {
      color: #fff;
      font-size: 18px;
      line-height: 1.6;
      margin-bottom: 15px;
    }

    .story-continue {
      color: #FF6B9D;
      font-size: 14px;
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0.3; }
    }

    .title-screen, .victory-screen {
      text-align: center;
      pointer-events: auto;
    }

    .victory-screen {
      max-height: 100%;
      overflow-y: auto;
      padding: 10px;
    }

    .title-screen h1 {
      color: #FF6B9D;
      font-size: 36px;
      margin-bottom: 20px;
      text-shadow: 0 0 20px rgba(255, 107, 157, 0.5);
    }

    .title-screen p {
      color: #fff;
      margin-bottom: 30px;
    }

    .btn {
      background: #FF6B9D;
      color: #fff;
      border: none;
      padding: 15px 30px;
      font-size: 18px;
      font-family: inherit;
      cursor: pointer;
      border-radius: 8px;
      margin: 5px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(255, 107, 157, 0.5);
    }

    .controls-hint {
      color: #888;
      font-size: 12px;
      margin-top: 20px;
    }

    .popup {
      position: absolute;
      background: rgba(0, 0, 0, 0.8);
      color: #fff;
      padding: 10px 15px;
      border-radius: 8px;
      font-size: 14px;
      border: 2px solid #FF6B9D;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s;
    }

    .popup.show {
      opacity: 1;
    }

    .hearts-counter {
      position: absolute;
      top: 10px;
      right: 15px;
      color: #FF6B9D;
      font-size: 20px;
      pointer-events: none;
    }

    .level-indicator {
      position: absolute;
      top: 10px;
      left: 15px;
      color: #fff;
      font-size: 14px;
      pointer-events: none;
    }

    #confetti-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .victory-screen h1 {
      color: #FF6B9D;
      font-size: 32px;
      margin-bottom: 10px;
    }

    .victory-screen p {
      color: #fff;
      font-size: 18px;
      margin-bottom: 20px;
    }

    .victory-screen .date-unlocked {
      color: #FFD700;
      font-size: 24px;
      margin: 20px 0;
    }

    #valentine-photo {
      position: relative;
      display: inline-block;
      margin: 15px auto;
    }

    #valentine-photo canvas {
      display: block;
      max-width: 280px;
      max-height: 280px;
      border-radius: 8px;
      border: 4px solid #8B4513;
      margin: 0 auto;
    }

    .ghop-text {
      position: absolute;
      font-size: 28px;
      font-weight: 900;
      font-style: italic;
      color: #fff;
      text-shadow: 
        -2px -2px 0 #000,
        2px -2px 0 #000,
        -2px 2px 0 #000,
        2px 2px 0 #000,
        0 0 10px rgba(255, 200, 0, 0.8);
      pointer-events: none;
      z-index: 10;
      animation: ghopPop 0.8s ease-out forwards;
    }

    @keyframes ghopPop {
      0% { transform: scale(0) rotate(-15deg); opacity: 1; }
      30% { transform: scale(1.3) rotate(5deg); opacity: 1; }
      50% { transform: scale(1) rotate(-3deg); opacity: 1; }
      100% { transform: scale(0.8) rotate(0deg); opacity: 0; }
    }

    .choco-btn {
      background: #5C3317 !important;
      border: 3px solid #D4A060 !important;
      font-size: 20px !important;
      padding: 12px 35px !important;
    }

    .choco-btn:hover {
      background: #8B4513 !important;
      box-shadow: 0 0 20px rgba(139, 66, 19, 0.7) !important;
    }

    .teddy-btn {
      background: #FF69B4 !important;
      border: 3px solid #FFB6C1 !important;
      font-size: 20px !important;
      padding: 12px 35px !important;
      margin-top: 15px !important;
      animation: teddyBtnPulse 2s ease-in-out infinite;
    }

    .teddy-btn:hover {
      background: #FF1493 !important;
      box-shadow: 0 0 20px rgba(255, 105, 180, 0.7) !important;
    }

    @keyframes teddyBtnPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    .teddy-victory-screen {
      text-align: center;
      pointer-events: auto;
      max-height: 100%;
      overflow-y: auto;
      padding: 10px;
    }

    .teddy-victory-screen h1 {
      color: #FF69B4;
      font-size: 28px;
      margin-bottom: 20px;
      text-shadow: 0 0 20px rgba(255, 105, 180, 0.5);
    }

    #teddy-victory-photo {
      position: relative;
      display: inline-block;
      margin: 15px auto;
    }

    #teddy-victory-photo canvas {
      display: block;
      max-width: 280px;
      max-height: 280px;
      border-radius: 8px;
      border: 4px solid #FF69B4;
      margin: 0 auto;
    }
  </style>
</head>
<body>
  <div id="game-container">
    <canvas id="gameCanvas" width="800" height="500"></canvas>
    <canvas id="confetti-canvas" width="800" height="500"></canvas>
    
    <div id="ui-overlay">
      <div class="level-indicator" id="level-indicator"></div>
      <div class="hearts-counter" id="hearts-counter"></div>
      
      <div class="title-screen" id="title-screen">
        <h1>Finding My Valentine.exe</h1>
        <p>A quest worth taking...</p>
        <button class="btn" id="start-btn">Start Quest</button>
        <div class="controls-hint">Arrow Keys or WASD to move | Space to jump</div>
      </div>
      
      <div class="story-box" id="story-box">
        <div class="story-text" id="story-text"></div>
        <div class="story-continue">[Click or Press Space to continue]</div>
      </div>
      
      <div class="victory-screen" id="victory-screen" style="display: none;">
        <h1>Will you be my Valentine? Pls.</h1>
        <p id="valentine-question"></p>
        <div id="valentine-photo"></div>
        <div>
          <button class="btn choco-btn" id="eat-choco-btn">Eat Chocolate</button>
          <button class="btn teddy-btn" id="continue-to-teddy-btn" style="display: none;">Continue...</button>
        </div>
      </div>
      
      <div class="teddy-victory-screen" id="teddy-victory-screen" style="display: none;">
        <h1>Now you can hug your real teddy</h1>
        <div id="teddy-victory-photo"></div>
        <div>
          <button class="btn teddy-btn" id="teddy-continue-btn" style="display: none;">Continue...</button>
        </div>
      </div>
      
      <div class="popup" id="popup"></div>
    </div>
  </div>

  <script>
    // ============================================
    // AUDIO SYSTEM - Web Audio API
    // ============================================
    let audioCtx = null;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
    }

    function playSound(type) {
      if (!audioCtx) return;
      
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      const now = audioCtx.currentTime;
      
      switch(type) {
        case 'jump':
          osc.frequency.setValueAtTime(200, now);
          osc.frequency.exponentialRampToValueAtTime(400, now + 0.1);
          gain.gain.setValueAtTime(0.3, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
          osc.start(now);
          osc.stop(now + 0.1);
          break;
          
        case 'collect':
          osc.frequency.setValueAtTime(440, now);
          osc.frequency.exponentialRampToValueAtTime(880, now + 0.1);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
          osc.start(now);
          osc.stop(now + 0.15);
          break;
          
        case 'levelComplete':
          const notes = [523, 659, 784, 1047];
          notes.forEach((freq, i) => {
            const o = audioCtx.createOscillator();
            const g = audioCtx.createGain();
            o.connect(g);
            g.connect(audioCtx.destination);
            o.frequency.value = freq;
            g.gain.setValueAtTime(0.2, now + i * 0.15);
            g.gain.exponentialRampToValueAtTime(0.01, now + i * 0.15 + 0.2);
            o.start(now + i * 0.15);
            o.stop(now + i * 0.15 + 0.2);
          });
          break;
          
        case 'victory':
          const fanfare = [523, 659, 784, 659, 784, 1047];
          fanfare.forEach((freq, i) => {
            const o = audioCtx.createOscillator();
            const g = audioCtx.createGain();
            o.connect(g);
            g.connect(audioCtx.destination);
            o.frequency.value = freq;
            g.gain.setValueAtTime(0.25, now + i * 0.12);
            g.gain.exponentialRampToValueAtTime(0.01, now + i * 0.12 + 0.25);
            o.start(now + i * 0.12);
            o.stop(now + i * 0.12 + 0.25);
          });
          break;
          
        case 'blip':
          osc.frequency.value = 600;
          gain.gain.setValueAtTime(0.1, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.03);
          osc.start(now);
          osc.stop(now + 0.03);
          break;

        case 'crack':
          // Chocolate square cracking - short snap
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(200, now);
          osc.frequency.exponentialRampToValueAtTime(60, now + 0.15);
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
          osc.start(now);
          osc.stop(now + 0.2);
          break;

        case 'chocoWin':
          // Victory chime - ascending notes
          osc.type = 'sine';
          osc.frequency.setValueAtTime(400, now);
          osc.frequency.exponentialRampToValueAtTime(600, now + 0.15);
          osc.frequency.exponentialRampToValueAtTime(800, now + 0.3);
          gain.gain.setValueAtTime(0.15, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
          osc.start(now);
          osc.stop(now + 0.5);
          break;

        case 'teddyHit':
          // Boing/boop sound when stomping teddy
          osc.type = 'sine';
          osc.frequency.setValueAtTime(300, now);
          osc.frequency.exponentialRampToValueAtTime(600, now + 0.08);
          osc.frequency.exponentialRampToValueAtTime(200, now + 0.2);
          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
          osc.start(now);
          osc.stop(now + 0.25);
          break;

        case 'teddyThrow':
          // Whoosh sound for projectile
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(400, now);
          osc.frequency.exponentialRampToValueAtTime(150, now + 0.12);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
          osc.start(now);
          osc.stop(now + 0.15);
          break;

        case 'playerHurt':
          // Ow/buzz when player takes damage
          osc.type = 'square';
          osc.frequency.setValueAtTime(200, now);
          osc.frequency.exponentialRampToValueAtTime(80, now + 0.15);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
          osc.start(now);
          osc.stop(now + 0.2);
          break;
      }
    }

    // ============================================
    // GAME STATE & CONSTANTS
    // ============================================
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const confettiCanvas = document.getElementById('confetti-canvas');
    const confettiCtx = confettiCanvas.getContext('2d');
    
    const GRAVITY = 0.5;
    const JUMP_STRENGTH = -11;
    const MOVE_SPEED = 2.8;
    const CANVAS_WIDTH = 800;
    const CANVAS_HEIGHT = 500;

    const Game = {
      state: 'title', // title, story, playing, victory
      currentLevel: 0,
      totalHearts: 0,
      
      player: {
        x: 50,
        y: 300,
        vx: 0,
        vy: 0,
        width: 32,
        height: 32,
        grounded: false,
        facing: 1,
        animFrame: 0
      },
      
      camera: { x: 0 },
      hearts: [],
      obstacles: [],
      platforms: [],
      particles: [],
      
      keys: {
        left: false,
        right: false,
        jump: false
      },
      
      storyQueue: [],
      currentStory: null,
      storyText: '',
      storyIndex: 0,
      storyComplete: false,
      storyTimeoutId: null
    };

    // ============================================
    // RUNNER MODE (Rose Day) - State & Assets
    // ============================================
    const gardenBgImg = new Image();
    gardenBgImg.src = '/valentine/rose-level-bg.png';

    const thornImg = new Image();
    thornImg.src = '/valentine/thorn.png';

    const chocoBgImg = new Image();
    chocoBgImg.src = '/valentine/chocolate-level-bg.png';

    const teddyBgImg = new Image();
    teddyBgImg.src = '/valentine/teddy-level-bg.png';

    const Runner = {
      active: false,
      lane: 1,           // 0=left, 1=center, 2=right
      laneX: 400,        // current visual X (smooth lerp)
      objects: [],        // {type:'rose'|'thorn', lane, z, collected}
      rosesCollected: 0,
      startTime: 0,
      elapsed: 0,
      speed: 0.003,      // z units per frame (ramps up)
      stunTimer: 0,       // frames remaining of stun shake
      finished: false,
      spawnTimer: 0,
      archScale: 0,       // grows from 0 to 1 at the end
      duration: 20,       // seconds to run
      lanePositions: [280, 400, 520],  // bottom-screen X for each lane
      vanishX: 400,
      vanishY: 180,
      playerY: 440,
      // Pixel-art player colors for runner mode
      runFrame: 0
    };

    // Rose messages shown when collecting roses
    const roseMessages = [
      "A red rose for courage",
      "Each petal holds a wish",
      "She loves me...",
      "Love is patient",
      "Love is kind",
      "She loves me not... jk, she does",
      "Almost there...",
      "One step closer",
      "Keep running!",
      "You're doing great!"
    ];

    // ============================================
    // FUNNY POPUP SYSTEM
    // ============================================
    const funnyPopups = [
      "This seemed easier in my head.",
      "Why are feelings harder than platformers?",
      "Okay wow, I'm actually doing this.",
      "At least there's no fall damage.",
      "Save point would be nice right about now.",
      "My palms are sweaty... wait, wrong reference.",
      "Is this what they call a side quest?",
      "Loading confidence... 23%",
      "Pro tip: Don't overthink it."
    ];
    
    let lastPopupTime = 0;
    let popupElement = document.getElementById('popup');

    function maybeShowPopup() {
      if (Game.state !== 'playing') return;
      if (Date.now() - lastPopupTime < 15000) return;
      if (Math.random() > 0.02) return;
      
      lastPopupTime = Date.now();
      const msg = funnyPopups[Math.floor(Math.random() * funnyPopups.length)];
      popupElement.textContent = msg;
      popupElement.style.top = (50 + Math.random() * 100) + 'px';
      popupElement.style.left = '50%';
      popupElement.style.transform = 'translateX(-50%)';
      popupElement.classList.add('show');
      
      setTimeout(() => {
        popupElement.classList.remove('show');
      }, 3000);
    }

    // ============================================
    // LEVEL DEFINITIONS
    // ============================================
    const levels = [
      // Level 1: Rose Day - 3-lane perspective runner
      {
        name: "Rose Day",
        introText: "Every love story begins with a single rose...",
        endText: "A garden full of roses, but only one worth picking.",
        isRunner: true
      },

      // Level 2: Chocolate Day - Survival on a crumbling chocolate bar
      {
        name: "Chocolate Day",
        introText: "Some things in life are bittersweet... but chocolate? Always sweet.\nStand on the chocolate bar. Squares will fall away. Survive to the last one!",
        endText: null,
        isChocolate: true,
        isFinal: true  // triggers chocolate-eat victory reveal; continues to teddy after
      },

      // Level 3: Teddy Day - Boss fight with a giant teddy bear (TRUE FINAL)
      {
        name: "Teddy Day",
        introText: "A wild teddy appears!\nIt won't let you hug it without a fight.\nJump on its head to show it who's boss!",
        endText: null,
        isTeddy: true,
        isFinal: true
      }
    ];

    // ============================================
    // LEVEL LOADING
    // ============================================
    function loadLevel(index) {
      const level = levels[index];
      Game.currentLevel = index;
      
      document.getElementById('level-indicator').textContent = `Level ${index + 1}: ${level.name}`;
      
      // Runner mode (Rose Day)
      if (level.isRunner) {
        showStory(level.introText, () => {
          Game.state = 'playing';
          initRunner();
        });
        return;
      }
      
      // Chocolate survival mode (Chocolate Day)
      if (level.isChocolate) {
        showStory(level.introText, () => {
          Game.state = 'playing';
          initChocolate();
        });
        return;
      }
      
      // Teddy boss fight mode (Teddy Day)
      if (level.isTeddy) {
        showStory(level.introText, () => {
          Game.state = 'playing';
          initTeddy();
        });
        return;
      }
      
      Game.player.x = 50;
      Game.player.y = level.groundY - 50;
      Game.player.vx = 0;
      Game.player.vy = 0;
      Game.player.grounded = false;
      
      Game.camera.x = 0;
      Game.platforms = level.platforms.map(p => ({ ...p }));
      Game.hearts = level.hearts.map(h => ({ ...h, collected: false }));
      Game.obstacles = level.obstacles.map(o => ({ ...o }));
      Game.particles = [];
      
      // Show intro story
      showStory(level.introText, () => {
        Game.state = 'playing';
      });
    }

    // ============================================
    // STORY SYSTEM
    // ============================================
    function showStory(text, callback) {
      // Clear any existing typewriter timeout
      if (Game.storyTimeoutId) {
        clearTimeout(Game.storyTimeoutId);
        Game.storyTimeoutId = null;
      }
      
      Game.state = 'story';
      Game.currentStory = { text: text, callback: callback };
      Game.storyText = '';
      Game.storyIndex = 0;
      Game.storyComplete = false;
      
      document.getElementById('story-box').style.display = 'block';
      document.getElementById('story-text').textContent = '';
      
      typewriterEffect();
    }

    function typewriterEffect() {
      if (!Game.currentStory) return;
      
      if (Game.storyIndex < Game.currentStory.text.length) {
        Game.storyText += Game.currentStory.text[Game.storyIndex];
        document.getElementById('story-text').textContent = Game.storyText;
        Game.storyIndex++;
        playSound('blip');
        Game.storyTimeoutId = setTimeout(typewriterEffect, 50);
      } else {
        Game.storyComplete = true;
        Game.storyTimeoutId = null;
      }
    }

    function advanceStory() {
      if (!Game.currentStory) return;
      
      if (!Game.storyComplete) {
        // Clear pending typewriter
        if (Game.storyTimeoutId) {
          clearTimeout(Game.storyTimeoutId);
          Game.storyTimeoutId = null;
        }
        // Skip to full text
        Game.storyText = Game.currentStory.text;
        document.getElementById('story-text').textContent = Game.storyText;
        Game.storyIndex = Game.currentStory.text.length;
        Game.storyComplete = true;
      } else {
        // Dismiss and callback
        document.getElementById('story-box').style.display = 'none';
        const cb = Game.currentStory.callback;
        Game.currentStory = null;
        if (cb) {
          cb();
        }
      }
    }

    // ============================================
    // RENDERING FUNCTIONS
    // ============================================
    function drawBackground(level) {
      const bg = levels[level].bgType;
      
      switch(bg) {
        case 'meadow':
          // Sky gradient
          const meadowGrad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
          meadowGrad.addColorStop(0, '#FFE4EC');
          meadowGrad.addColorStop(1, '#FFF0F5');
          ctx.fillStyle = meadowGrad;
          ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
          
          // Distant hills
          ctx.fillStyle = '#90EE90';
          for (let i = 0; i < 5; i++) {
            ctx.beginPath();
            ctx.arc(i * 200 - Game.camera.x * 0.2, CANVAS_HEIGHT - 50, 150, Math.PI, 0);
            ctx.fill();
          }
          
          // Pixel flowers (background)
          ctx.fillStyle = '#FF6B9D';
          for (let i = 0; i < 20; i++) {
            const fx = (i * 100 + 50) - (Game.camera.x * 0.5) % 200;
            ctx.fillRect(fx, 350, 4, 4);
            ctx.fillRect(fx - 4, 354, 4, 4);
            ctx.fillRect(fx + 4, 354, 4, 4);
          }
          break;
          
        case 'city':
          // Sunset gradient
          const cityGrad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
          cityGrad.addColorStop(0, '#FF9966');
          cityGrad.addColorStop(0.5, '#FF5E62');
          cityGrad.addColorStop(1, '#CC66FF');
          ctx.fillStyle = cityGrad;
          ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
          
          // Buildings silhouette
          ctx.fillStyle = '#2D2D44';
          const buildings = [80, 120, 60, 140, 90, 110, 70, 130, 85, 100];
          buildings.forEach((h, i) => {
            const bx = i * 100 - (Game.camera.x * 0.3) % 100;
            ctx.fillRect(bx, CANVAS_HEIGHT - 100 - h, 80, h);
            // Windows
            ctx.fillStyle = '#FFD700';
            for (let wy = 0; wy < h - 20; wy += 20) {
              for (let wx = 10; wx < 70; wx += 20) {
                if (Math.random() > 0.3) {
                  ctx.fillRect(bx + wx, CANVAS_HEIGHT - 90 - h + wy, 8, 12);
                }
              }
            }
            ctx.fillStyle = '#2D2D44';
          });
          break;
          
        case 'night':
          // Dark sky
          ctx.fillStyle = '#1A1A2E';
          ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
          
          // Stars
          ctx.fillStyle = '#FFF';
          for (let i = 0; i < 50; i++) {
            const sx = (i * 37 + Game.camera.x * 0.1) % CANVAS_WIDTH;
            const sy = (i * 23) % (CANVAS_HEIGHT - 150);
            const twinkle = Math.sin(Date.now() / 500 + i) * 0.5 + 0.5;
            ctx.globalAlpha = twinkle;
            ctx.fillRect(sx, sy, 2, 2);
          }
          ctx.globalAlpha = 1;
          
          // Moon
          ctx.fillStyle = '#FFE4B5';
          ctx.beginPath();
          ctx.arc(650 - Game.camera.x * 0.05, 80, 40, 0, Math.PI * 2);
          ctx.fill();
          break;

        case 'room':
          // Warm room
          const roomGrad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
          roomGrad.addColorStop(0, '#FFF0F5');
          roomGrad.addColorStop(1, '#FFE4EC');
          ctx.fillStyle = roomGrad;
          ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
          
          // Heart decorations
          ctx.fillStyle = '#FF6B9D';
          for (let i = 0; i < 8; i++) {
            const hx = 100 + i * 90;
            const hy = 50 + Math.sin(Date.now() / 1000 + i) * 10;
            drawHeart(hx, hy, 15);
          }
          break;
      }
    }

    function drawHeart(x, y, size) {
      ctx.save();
      ctx.translate(x, y);
      ctx.beginPath();
      ctx.moveTo(0, size / 4);
      ctx.bezierCurveTo(-size / 2, -size / 4, -size, size / 4, 0, size);
      ctx.bezierCurveTo(size, size / 4, size / 2, -size / 4, 0, size / 4);
      ctx.fill();
      ctx.restore();
    }

    function drawPlayer() {
      const p = Game.player;
      const screenX = p.x - Game.camera.x;
      
      ctx.save();
      ctx.translate(screenX + p.width / 2, p.y + p.height / 2);
      ctx.scale(p.facing, 1);
      ctx.translate(-p.width / 2, -p.height / 2);
      
      // Body
      ctx.fillStyle = '#4A90D9';
      ctx.fillRect(4, 8, 24, 20);
      
      // Head
      ctx.fillStyle = '#FFD5B5';
      ctx.fillRect(6, 0, 20, 14);
      
      // Eyes
      ctx.fillStyle = '#333';
      ctx.fillRect(10, 4, 4, 4);
      ctx.fillRect(18, 4, 4, 4);
      
      // Smile
      ctx.fillRect(12, 10, 8, 2);
      
      // Legs
      ctx.fillStyle = '#333';
      const legOffset = Math.abs(Math.sin(Date.now() / 100)) * (Math.abs(p.vx) > 0.1 ? 4 : 0);
      ctx.fillRect(8, 28, 6, 4 + legOffset);
      ctx.fillRect(18, 28, 6, 4 + (4 - legOffset));
      
      ctx.restore();
    }

    function drawPlatforms() {
      Game.platforms.forEach(plat => {
        const screenX = plat.x - Game.camera.x;
        if (screenX > CANVAS_WIDTH + 100 || screenX + plat.w < -100) return;
        
        const level = levels[Game.currentLevel];
        
        // Platform style based on level
        switch(level.bgType) {
          case 'meadow':
            ctx.fillStyle = '#7BC96F';
            ctx.fillRect(screenX, plat.y, plat.w, plat.h);
            // Grass top
            ctx.fillStyle = '#4CAF50';
            ctx.fillRect(screenX, plat.y, plat.w, 8);
            break;
          case 'city':
            ctx.fillStyle = '#555';
            ctx.fillRect(screenX, plat.y, plat.w, plat.h);
            ctx.fillStyle = '#666';
            ctx.fillRect(screenX, plat.y, plat.w, 5);
            break;
          case 'night':
            ctx.fillStyle = 'rgba(200, 200, 255, 0.3)';
            ctx.fillRect(screenX, plat.y, plat.w, plat.h);
            // Ethereal glow
            ctx.shadowColor = '#AAF';
            ctx.shadowBlur = 10;
            ctx.fillRect(screenX, plat.y, plat.w, 5);
            ctx.shadowBlur = 0;
            break;
          case 'room':
            ctx.fillStyle = '#DEB887';
            ctx.fillRect(screenX, plat.y, plat.w, plat.h);
            break;
        }
      });
    }

    // ============================================
    // CHOCOLATE DAY - SURVIVAL MINI-GAME
    // ============================================

    const Choco = {
      active: false,
      grid: [],           // 8x2 array of square objects
      cols: 8,
      rows: 2,
      squareW: 70,
      squareH: 70,
      gridX: 0,           // computed in init (centered)
      gridY: 0,           // computed in init
      nextCol: 0,          // index into dropOrder array
      dropTimer: 0,        // frames until next column starts dropping
      dropInterval: 360,   // frames between column drops (~6s)
      dropOrder: [],       // shuffled array of column indices to drop
      safeCol: 0,          // the one column that never drops (random)
      won: false,
      winTimer: 0,
      lost: false,
      lostTimer: 0,
      started: false,      // drops haven't begun yet
      startDelay: 180,     // 3 second grace period
      startTimer: 0,
      particles: [],
      bigChocoScale: 0,
      confettiParts: []
    };

    // ============================================
    // TEDDY MODE (Teddy Day) - Boss Fight State
    // ============================================
    const Teddy = {
      active: false,
      health: 5,
      maxHealth: 5,
      x: 580,
      y: 300,
      w: 100,
      h: 120,
      baseY: 300,
      facing: -1,
      phase: 'idle',       // idle, charging, throwing, stunned, defeated
      phaseTimer: 0,
      attackTimer: 0,
      attackInterval: 160,  // frames between attacks (ramps down)
      stunDuration: 90,     // frames of stun after being hit
      projectiles: [],      // hearts thrown at player
      hitFlash: 0,          // frames of white flash when hit
      defeatTimer: 0,
      bounceOffset: 0,      // visual bounce animation
      bounceSpeed: 0.05,
      angerLevel: 0,        // increases as health drops
      shakeAmount: 0,
      particles: [],
      // Ground / arena
      groundY: 420,
      // Win animation
      won: false,
      winTimer: 0,
      confettiParts: [],
      // Player HP (teddy mode only)
      playerHealth: 13,
      playerMaxHealth: 13,
      playerHitFlash: 0,
      playerInvincible: 0,  // i-frames after taking damage
      // Teddy movement AI
      vx: 0,
      vy: 0,
      moveDir: -1,        // -1 = left, 1 = right
      moveTimer: 0,
      jumpTimer: 0,
      jumpCooldown: 0,
      teddyGrounded: true,
      // Game over
      playerDead: false,
      deathTimer: 0
    };

    function initChocolate() {
      Choco.active = true;
      Choco.won = false;
      Choco.lost = false;
      Choco.winTimer = 0;
      Choco.lostTimer = 0;
      Choco.nextCol = 0;
      Choco.dropTimer = 0;
      Choco.started = false;
      Choco.startTimer = 0;
      Choco.particles = [];
      Choco.bigChocoScale = 0;
      Choco.confettiParts = [];
      
      // Pick a random safe column (the one that never drops)
      Choco.safeCol = Math.floor(Math.random() * Choco.cols);
      
      // Build shuffled drop order of all columns EXCEPT the safe one
      Choco.dropOrder = [];
      for (let i = 0; i < Choco.cols; i++) {
        if (i !== Choco.safeCol) Choco.dropOrder.push(i);
      }
      // Fisher-Yates shuffle
      for (let i = Choco.dropOrder.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [Choco.dropOrder[i], Choco.dropOrder[j]] = [Choco.dropOrder[j], Choco.dropOrder[i]];
      }
      
      // Center the grid on canvas
      const totalW = Choco.cols * Choco.squareW;
      const totalH = Choco.rows * Choco.squareH;
      Choco.gridX = (CANVAS_WIDTH - totalW) / 2;
      Choco.gridY = CANVAS_HEIGHT - totalH - 60; // 60px above bottom
      
      // Build grid
      Choco.grid = [];
      for (let row = 0; row < Choco.rows; row++) {
        for (let col = 0; col < Choco.cols; col++) {
          Choco.grid.push({
            row, col,
            x: Choco.gridX + col * Choco.squareW,
            y: Choco.gridY + row * Choco.squareH,
            w: Choco.squareW,
            h: Choco.squareH,
            state: 'stable',    // stable, shaking, falling, gone
            timer: 0,
            fallVy: 0,
            fallOffset: 0,
            shakeOffset: 0,
            cracks: [],
            rotation: 0
          });
        }
      }
      
      // Player starts on top center of the bar
      Game.player.x = CANVAS_WIDTH / 2 - Game.player.width / 2;
      Game.player.y = Choco.gridY - Game.player.height - 2;
      Game.player.vx = 0;
      Game.player.vy = 0;
      Game.player.grounded = true;
      Game.camera.x = 0;
    }

    function updateChocolate() {
      if (!Choco.active) return;
      
      // If already won, skip gameplay and only run win animation
      if (Choco.won) {
        Choco.winTimer++;
        Choco.bigChocoScale = Math.min(Choco.bigChocoScale + 0.02, 1);
        // Spawn confetti
        if (Choco.winTimer % 3 === 0 && Choco.confettiParts.length < 80) {
          Choco.confettiParts.push({
            x: Math.random() * CANVAS_WIDTH,
            y: -10,
            vx: (Math.random() - 0.5) * 3,
            vy: Math.random() * 2 + 1,
            size: 4 + Math.random() * 4,
            color: ['#FF6B9D', '#FFD700', '#FF69B4', '#87CEEB', '#98FB98', '#DDA0DD'][Math.floor(Math.random() * 6)],
            rot: Math.random() * Math.PI * 2,
            rotSpeed: (Math.random() - 0.5) * 0.2
          });
        }
        Choco.confettiParts.forEach(c => {
          c.x += c.vx;
          c.y += c.vy;
          c.rot += c.rotSpeed;
        });
        Choco.confettiParts = Choco.confettiParts.filter(c => c.y < CANVAS_HEIGHT + 20);
        
        // After 4 seconds, advance to victory
        if (Choco.winTimer > 240) {
          Choco.active = false;
          const level = levels[Game.currentLevel];
          playSound('levelComplete');
          if (level.isFinal) {
            showVictory();
          } else if (level.endText) {
            showStory(level.endText, () => {
              loadLevel(Game.currentLevel + 1);
            });
          } else {
            loadLevel(Game.currentLevel + 1);
          }
        }
        return;
      }
      
      const p = Game.player;
      
      // Grace period before drops start
      if (!Choco.started) {
        Choco.startTimer++;
        if (Choco.startTimer >= Choco.startDelay) {
          Choco.started = true;
        }
      }
      
      // Player movement (left/right)
      if (Game.keys.left) p.vx = -MOVE_SPEED;
      else if (Game.keys.right) p.vx = MOVE_SPEED;
      else p.vx *= 0.7;
      
      // Jump
      if (Game.keys.jump && p.grounded) {
        p.vy = JUMP_STRENGTH;
        p.grounded = false;
        playSound('jump');
        Game.keys.jump = false;
      }
      
      // Gravity
      p.vy += GRAVITY;
      p.x += p.vx;
      p.y += p.vy;
      
      // Collision with chocolate squares
      p.grounded = false;
      Choco.grid.forEach(sq => {
        if (sq.state === 'falling' || sq.state === 'gone') return;
        const sqY = sq.y + (sq.state === 'shaking' ? (Math.random() - 0.5) * 2 : 0);
        if (p.x + p.width > sq.x + 4 && p.x < sq.x + sq.w - 4 &&
            p.y + p.height > sqY && p.y + p.height < sqY + sq.h + 15 &&
            p.vy >= 0) {
          p.y = sqY - p.height;
          p.vy = 0;
          p.grounded = true;
        }
      });
      
      // Keep player in bounds horizontally
      if (p.x < 0) p.x = 0;
      if (p.x + p.width > CANVAS_WIDTH) p.x = CANVAS_WIDTH - p.width;
      
      // Drop columns in random order (skipping the safe column)
      if (Choco.started && Choco.nextCol < Choco.dropOrder.length) {
        Choco.dropTimer++;
        if (Choco.dropTimer >= Choco.dropInterval) {
          Choco.dropTimer = 0;
          const colToDrop = Choco.dropOrder[Choco.nextCol];
          // Start shaking all squares in this column
          Choco.grid.forEach(sq => {
            if (sq.col === colToDrop && sq.state === 'stable') {
              sq.state = 'shaking';
              sq.timer = 0;
              // Generate crack positions
              sq.cracks = [];
              for (let ci = 0; ci < 3; ci++) {
                sq.cracks.push({
                  x1: Math.random() * sq.w * 0.3,
                  y1: Math.random() * sq.h,
                  x2: sq.w * 0.3 + Math.random() * sq.w * 0.4,
                  y2: Math.random() * sq.h,
                  x3: sq.w * 0.7 + Math.random() * sq.w * 0.3,
                  y3: Math.random() * sq.h
                });
              }
            }
          });
          Choco.nextCol++;
        }
      }
      
      // Update square states
      Choco.grid.forEach(sq => {
        if (sq.state === 'shaking') {
          sq.timer++;
          sq.shakeOffset = (Math.random() - 0.5) * 4;
          if (sq.timer >= 90) { // 1.5 seconds of shaking
            sq.state = 'falling';
            sq.timer = 0;
            sq.fallVy = 0;
            sq.fallOffset = 0;
            sq.rotation = 0;
            playSound('crack');
            // Spawn crumb particles
            for (let pi = 0; pi < 6; pi++) {
              Choco.particles.push({
                x: sq.x + Math.random() * sq.w,
                y: sq.y + sq.h,
                vx: (Math.random() - 0.5) * 3,
                vy: -Math.random() * 2 - 1,
                life: 40 + Math.random() * 20,
                maxLife: 60,
                size: 2 + Math.random() * 3,
                color: Math.random() > 0.5 ? '#5C3317' : '#8B6240'
              });
            }
          }
        }
        if (sq.state === 'falling') {
          sq.fallVy += 0.4;
          sq.fallOffset += sq.fallVy;
          sq.rotation += 0.02;
          if (sq.fallOffset > CANVAS_HEIGHT) {
            sq.state = 'gone';
          }
        }
      });
      
      // Update particles
      Choco.particles.forEach(pt => {
        pt.x += pt.vx;
        pt.y += pt.vy;
        pt.vy += 0.15;
        pt.life--;
      });
      Choco.particles = Choco.particles.filter(pt => pt.life > 0);
      
      // Check win: all droppable columns have fully fallen away, and player is still alive on the safe column
      const allDroppedGone = Choco.nextCol >= Choco.dropOrder.length && 
        Choco.grid.filter(sq => sq.col !== Choco.safeCol).every(sq => sq.state === 'gone');
      const safeColSquares = Choco.grid.filter(sq => sq.col === Choco.safeCol && sq.state === 'stable');
      
      if (allDroppedGone && safeColSquares.length > 0 && p.grounded && p.y < CANVAS_HEIGHT) {
        Choco.won = true;
        Choco.winTimer = 0;
        playSound('chocoWin');
      }
      
      // Check loss: player falls off screen
      if (p.y > CANVAS_HEIGHT + 50) {
        Choco.lost = true;
        Choco.lostTimer++;
        if (Choco.lostTimer > 90) {
          // Restart the chocolate level
          Choco.active = false;
          loadLevel(Game.currentLevel);
        }
      }
    }

    function drawChocolate() {
      // Background - chocolate level image
      if (chocoBgImg.complete && chocoBgImg.naturalWidth > 0) {
        ctx.drawImage(chocoBgImg, 0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      } else {
        // Fallback gradient while image loads
        const bgGrad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
        bgGrad.addColorStop(0, '#4A2C2A');
        bgGrad.addColorStop(0.5, '#6B3A2E');
        bgGrad.addColorStop(1, '#D2A679');
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      }
      
      // Floating cocoa particles in background
      ctx.fillStyle = 'rgba(90, 50, 20, 0.25)';
      for (let ci = 0; ci < 20; ci++) {
        const cpx = (ci * 67 + Date.now() / 40) % (CANVAS_WIDTH + 100) - 50;
        const cpy = (ci * 43 + Math.sin(Date.now() / 700 + ci) * 25) % CANVAS_HEIGHT;
        ctx.fillRect(cpx, cpy, 3, 3);
      }
      
      // Draw chocolate bar wrapper/tray underneath
      const trayX = Choco.gridX - 10;
      const trayY = Choco.gridY - 5;
      const trayW = Choco.cols * Choco.squareW + 20;
      const trayH = Choco.rows * Choco.squareH + 15;
      ctx.fillStyle = '#8B4513';
      ctx.fillRect(trayX, trayY, trayW, trayH);
      ctx.strokeStyle = '#D4A060';
      ctx.lineWidth = 2;
      ctx.strokeRect(trayX, trayY, trayW, trayH);
      
      // Draw each chocolate square
      Choco.grid.forEach(sq => {
        if (sq.state === 'gone') return;
        
        let drawX = sq.x;
        let drawY = sq.y;
        let alpha = 1;
        
        if (sq.state === 'shaking') {
          drawX += sq.shakeOffset;
          drawY += (Math.random() - 0.5) * 2;
        }
        if (sq.state === 'falling') {
          drawY += sq.fallOffset;
          alpha = Math.max(0, 1 - sq.fallOffset / 300);
        }
        
        ctx.save();
        ctx.globalAlpha = alpha;
        
        if (sq.state === 'falling') {
          const cx = drawX + sq.w / 2;
          const cy = drawY + sq.h / 2;
          ctx.translate(cx, cy);
          ctx.rotate(sq.rotation);
          ctx.translate(-cx, -cy);
        }
        
        // Square body - dark chocolate
        ctx.fillStyle = '#3B1F0E';
        ctx.fillRect(drawX + 1, drawY + 1, sq.w - 2, sq.h - 2);
        
        // Inner raised portion (lighter)
        const inset = 6;
        ctx.fillStyle = '#5C3317';
        ctx.fillRect(drawX + inset, drawY + inset, sq.w - inset * 2, sq.h - inset * 2);
        
        // Glossy top-left highlight
        const shineGrad = ctx.createLinearGradient(drawX, drawY, drawX + sq.w * 0.5, drawY + sq.h * 0.5);
        shineGrad.addColorStop(0, 'rgba(255, 255, 255, 0.15)');
        shineGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = shineGrad;
        ctx.fillRect(drawX + inset, drawY + inset, sq.w - inset * 2, sq.h - inset * 2);
        
        // Grid groove lines (between squares)
        ctx.strokeStyle = '#2A1508';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(drawX + 1, drawY + 1, sq.w - 2, sq.h - 2);
        
        // Crack lines during shaking
        if (sq.state === 'shaking' && sq.cracks.length > 0) {
          const crackProgress = Math.min(sq.timer / 60, 1);
          ctx.strokeStyle = '#1A0A04';
          ctx.lineWidth = 1.5;
          sq.cracks.forEach(crack => {
            ctx.beginPath();
            ctx.moveTo(drawX + crack.x1, drawY + crack.y1);
            ctx.lineTo(drawX + crack.x1 + (crack.x2 - crack.x1) * crackProgress, 
                       drawY + crack.y1 + (crack.y2 - crack.y1) * crackProgress);
            if (crackProgress > 0.5) {
              ctx.lineTo(drawX + crack.x2 + (crack.x3 - crack.x2) * (crackProgress - 0.5) * 2,
                         drawY + crack.y2 + (crack.y3 - crack.y2) * (crackProgress - 0.5) * 2);
            }
            ctx.stroke();
          });
        }
        
        ctx.restore();
      });
      
      // Draw crumb particles
      Choco.particles.forEach(pt => {
        const ptAlpha = pt.life / pt.maxLife;
        ctx.fillStyle = pt.color;
        ctx.globalAlpha = ptAlpha;
        ctx.fillRect(pt.x, pt.y, pt.size, pt.size);
      });
      ctx.globalAlpha = 1;
      
      // Draw player (reuse the existing pixel art player)
      if (!Choco.won || Choco.winTimer < 120) {
        drawPlayer();
      }
      
      // Countdown text before drops start
      if (!Choco.started && Choco.startTimer < Choco.startDelay) {
        const countdown = Math.ceil((Choco.startDelay - Choco.startTimer) / 60);
        ctx.fillStyle = '#FFD700';
        ctx.font = 'bold 48px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(countdown > 0 ? String(countdown) : 'GO!', CANVAS_WIDTH / 2, 100);
        ctx.font = '16px monospace';
        ctx.fillStyle = '#FFF5E6';
        ctx.fillText('Get ready! The chocolate is about to crumble!', CANVAS_WIDTH / 2, 140);
        ctx.textAlign = 'left';
      }
      
      // "Survive!" indicator during gameplay
      if (Choco.started && !Choco.won && !Choco.lost) {
        const remaining = Choco.grid.filter(sq => sq.state === 'stable' || sq.state === 'shaking').length;
        ctx.fillStyle = '#FFF5E6';
        ctx.font = '14px monospace';
        ctx.textAlign = 'center';
        ctx.fillText(`Squares remaining: ${remaining} / ${Choco.cols * Choco.rows}`, CANVAS_WIDTH / 2, 30);
        ctx.textAlign = 'left';
      }
      
      // Loss message
      if (Choco.lost) {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        ctx.fillStyle = '#FF6B6B';
        ctx.font = 'bold 36px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('You fell!', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 - 20);
        ctx.fillStyle = '#FFF';
        ctx.font = '18px monospace';
        ctx.fillText('Trying again...', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 20);
        ctx.textAlign = 'left';
      }
      
      // Win sequence
      if (Choco.won) {
        // Confetti
        Choco.confettiParts.forEach(c => {
          ctx.save();
          ctx.translate(c.x, c.y);
          ctx.rotate(c.rot);
          ctx.fillStyle = c.color;
          ctx.fillRect(-c.size / 2, -c.size / 2, c.size, c.size * 0.6);
          ctx.restore();
        });
        
        // Big chocolate bar scaling up from center
        const scale = Choco.bigChocoScale;
        if (scale > 0) {
          ctx.save();
          ctx.translate(CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 - 30);
          ctx.scale(scale, scale);
          
          // Big chocolate bar
          const bw = 180, bh = 100;
          // Wrapper
          ctx.fillStyle = '#DAA520';
          ctx.fillRect(-bw / 2 - 10, -bh / 2 - 10, bw + 20, bh + 20);
          ctx.strokeStyle = '#B8860B';
          ctx.lineWidth = 3;
          ctx.strokeRect(-bw / 2 - 10, -bh / 2 - 10, bw + 20, bh + 20);
          // Chocolate
          ctx.fillStyle = '#3B1F0E';
          ctx.fillRect(-bw / 2, -bh / 2, bw, bh);
          // Grid on the chocolate
          ctx.strokeStyle = '#2A1508';
          ctx.lineWidth = 1;
          for (let gi = 1; gi < 4; gi++) {
            ctx.beginPath();
            ctx.moveTo(-bw / 2 + gi * (bw / 4), -bh / 2);
            ctx.lineTo(-bw / 2 + gi * (bw / 4), bh / 2);
            ctx.stroke();
          }
          ctx.beginPath();
          ctx.moveTo(-bw / 2, 0);
          ctx.lineTo(bw / 2, 0);
          ctx.stroke();
          // Shine
          ctx.fillStyle = 'rgba(255,255,255,0.12)';
          ctx.fillRect(-bw / 2, -bh / 2, bw, bh / 3);
          
          ctx.restore();
          
          // Congratulations text
          if (Choco.winTimer > 30) {
            const textAlpha = Math.min((Choco.winTimer - 30) / 30, 1);
            ctx.globalAlpha = textAlpha;
            
            // Glow
            ctx.shadowColor = '#FFD700';
            ctx.shadowBlur = 20;
            ctx.fillStyle = '#FFD700';
            ctx.font = 'bold 32px monospace';
            ctx.textAlign = 'center';
            ctx.fillText('Congratulations!', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 60);
            ctx.shadowBlur = 0;
            
            ctx.fillStyle = '#FFF';
            ctx.font = '18px monospace';
            ctx.fillText('You survived the Chocolate Day!', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 90);
            ctx.textAlign = 'left';
            ctx.globalAlpha = 1;
          }
          
          // "To be continued..." text
          if (Choco.winTimer > 120) {
            const contAlpha = Math.min((Choco.winTimer - 120) / 40, 1);
            ctx.globalAlpha = contAlpha;
            ctx.fillStyle = '#FFB6C1';
            ctx.font = 'italic 22px monospace';
            ctx.textAlign = 'center';
            ctx.fillText('To be continued...', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 125);
            ctx.textAlign = 'left';
            ctx.globalAlpha = 1;
          }
        }
      }
    }

    function drawHearts() {
      Game.hearts.forEach(heart => {
        if (heart.collected) return;
        
        const screenX = heart.x - Game.camera.x;
        if (screenX > CANVAS_WIDTH + 50 || screenX < -50) return;
        
        const bounce = Math.sin(Date.now() / 300 + heart.x) * 5;
        
        ctx.fillStyle = '#FF6B9D';
        drawHeart(screenX, heart.y + bounce, 12);
        
        // Glow
        ctx.shadowColor = '#FF6B9D';
        ctx.shadowBlur = 10;
        drawHeart(screenX, heart.y + bounce, 12);
        ctx.shadowBlur = 0;
      });
    }

    function drawObstacles() {
      Game.obstacles.forEach(obs => {
        const screenX = obs.x - Game.camera.x;
        if (screenX > CANVAS_WIDTH + 100 || screenX < -100) return;
        
        switch(obs.type) {
          case 'cloud':
            ctx.fillStyle = '#888';
            ctx.beginPath();
            ctx.arc(screenX + 20, obs.y + 20, 20, 0, Math.PI * 2);
            ctx.arc(screenX + 45, obs.y + 15, 25, 0, Math.PI * 2);
            ctx.arc(screenX + 70, obs.y + 22, 18, 0, Math.PI * 2);
            ctx.fill();
            // Worried face
            ctx.fillStyle = '#555';
            ctx.fillRect(screenX + 35, obs.y + 10, 4, 4);
            ctx.fillRect(screenX + 50, obs.y + 10, 4, 4);
            ctx.fillRect(screenX + 38, obs.y + 22, 12, 3);
            break;
            
          case 'rock':
            ctx.fillStyle = '#666';
            ctx.beginPath();
            ctx.moveTo(screenX, obs.y + obs.h);
            ctx.lineTo(screenX + obs.w / 2, obs.y);
            ctx.lineTo(screenX + obs.w, obs.y + obs.h);
            ctx.closePath();
            ctx.fill();
            break;
            
          case 'notification':
            const bobY = obs.y + Math.sin(Date.now() / 200 + obs.x) * 10;
            ctx.fillStyle = '#3B82F6';
            ctx.fillRect(screenX, bobY, obs.w, obs.h);
            ctx.fillStyle = '#FFF';
            ctx.font = 'bold 24px Arial';
            ctx.fillText('!', screenX + 20, bobY + 30);
            break;
            
          case 'npc':
            ctx.fillStyle = '#8B5CF6';
            ctx.fillRect(screenX + 4, obs.y + 16, 24, 32);
            ctx.fillStyle = '#FFD5B5';
            ctx.fillRect(screenX + 6, obs.y, 20, 18);
            // Speech bubble
            ctx.fillStyle = '#FFF';
            ctx.fillRect(screenX - 60, obs.y - 30, 120, 25);
            ctx.fillStyle = '#333';
            ctx.font = '10px Arial';
            ctx.fillText('You sure about this?', screenX - 55, obs.y - 12);
            break;
          
          case 'girl':
            // Dress
            ctx.fillStyle = obs.color || '#FF69B4';
            ctx.beginPath();
            ctx.moveTo(screenX + 4, obs.y + 18);
            ctx.lineTo(screenX + 28, obs.y + 18);
            ctx.lineTo(screenX + 32, obs.y + 48);
            ctx.lineTo(screenX, obs.y + 48);
            ctx.closePath();
            ctx.fill();
            // Face
            ctx.fillStyle = '#FFD5B5';
            ctx.fillRect(screenX + 6, obs.y, 20, 18);
            // Hair
            ctx.fillStyle = '#4A3728';
            ctx.fillRect(screenX + 4, obs.y - 4, 24, 10);
            ctx.fillRect(screenX + 2, obs.y + 2, 6, 14);
            ctx.fillRect(screenX + 24, obs.y + 2, 6, 14);
            // Eyes
            ctx.fillStyle = '#333';
            ctx.fillRect(screenX + 10, obs.y + 6, 3, 3);
            ctx.fillRect(screenX + 19, obs.y + 6, 3, 3);
            // Smile
            ctx.fillRect(screenX + 12, obs.y + 12, 8, 2);
            // Speech bubble with message
            ctx.fillStyle = '#FFF';
            ctx.fillRect(screenX - 30, obs.y - 35, 90, 25);
            // Bubble tail
            ctx.beginPath();
            ctx.moveTo(screenX + 10, obs.y - 10);
            ctx.lineTo(screenX + 20, obs.y - 10);
            ctx.lineTo(screenX + 15, obs.y - 2);
            ctx.closePath();
            ctx.fill();
            ctx.fillStyle = '#FF69B4';
            ctx.font = 'bold 11px Arial';
            ctx.fillText(obs.msg || 'Hi~', screenX - 25, obs.y - 17);
            break;
            
          case 'monster':
            if (obs.defeated) {
              // Sparkle particles
              ctx.fillStyle = '#FFD700';
              for (let i = 0; i < 5; i++) {
                const px = screenX + obs.w / 2 + Math.cos(Date.now() / 200 + i) * 30;
                const py = obs.y + obs.h / 2 + Math.sin(Date.now() / 200 + i) * 30;
                ctx.fillRect(px, py, 4, 4);
              }
            } else {
              // Scary looking but harmless monster
              ctx.fillStyle = '#2D1B4E';
              ctx.fillRect(screenX, obs.y, obs.w, obs.h);
              // Red eyes
              ctx.fillStyle = '#FF0000';
              ctx.fillRect(screenX + 12, obs.y + 20, 12, 8);
              ctx.fillRect(screenX + 40, obs.y + 20, 12, 8);
              // Teeth
              ctx.fillStyle = '#FFF';
              for (let i = 0; i < 5; i++) {
                ctx.fillRect(screenX + 10 + i * 10, obs.y + 50, 6, 10);
              }
              // Menacing aura
              ctx.strokeStyle = 'rgba(128, 0, 128, 0.5)';
              ctx.lineWidth = 2;
              ctx.strokeRect(screenX - 5, obs.y - 5, obs.w + 10, obs.h + 10);
            }
            break;
        }
      });
    }

    function drawParticles() {
      Game.particles = Game.particles.filter(p => {
        p.x += p.vx;
        p.y += p.vy;
        p.life -= 0.02;
        
        if (p.life <= 0) return false;
        
        ctx.globalAlpha = p.life;
        ctx.fillStyle = p.color;
        ctx.fillRect(p.x - Game.camera.x, p.y, p.size, p.size);
        ctx.globalAlpha = 1;
        
        return true;
      });
    }

    function spawnParticles(x, y, color, count) {
      for (let i = 0; i < count; i++) {
        Game.particles.push({
          x: x,
          y: y,
          vx: (Math.random() - 0.5) * 6,
          vy: (Math.random() - 0.5) * 6,
          size: 4 + Math.random() * 4,
          color: color,
          life: 1
        });
      }
    }

    // Show a temporary game message (not a story box)
    function showGameMessage(msg) {
      popupElement.textContent = msg;
      popupElement.style.top = '40%';
      popupElement.style.left = '50%';
      popupElement.style.transform = 'translate(-50%, -50%)';
      popupElement.style.fontSize = '18px';
      popupElement.classList.add('show');
      
      setTimeout(() => {
        popupElement.classList.remove('show');
        popupElement.style.fontSize = '14px';
      }, 2500);
    }

    // ============================================
    // RUNNER MODE FUNCTIONS (Rose Day)
    // ============================================
    function initRunner() {
      Runner.active = true;
      Runner.lane = 1;
      Runner.laneX = Runner.lanePositions[1];
      Runner.objects = [];
      Runner.rosesCollected = 0;
      Runner.startTime = Date.now();
      Runner.elapsed = 0;
      Runner.speed = 0.012;
      Runner.stunTimer = 0;
      Runner.finished = false;
      Runner.spawnTimer = 0;
      Runner.archScale = 0;
      Runner.runFrame = 0;
    }

    function updateRunner() {
      const now = Date.now();
      Runner.elapsed = (now - Runner.startTime) / 1000;
      Runner.runFrame++;

      // Smooth lane transition
      const targetX = Runner.lanePositions[Runner.lane];
      Runner.laneX += (targetX - Runner.laneX) * 0.15;

      // Speed ramps up slightly over time (much slower)
      Runner.speed = 0.003 + Runner.elapsed * 0.00005;

      // Decrease stun timer
      if (Runner.stunTimer > 0) Runner.stunTimer--;

      // Check if we've reached the end
      if (Runner.elapsed >= Runner.duration && !Runner.finished) {
        Runner.finished = true;
        // Show the end screen for 5 seconds, then finish
        setTimeout(() => {
          finishRunner();
        }, 5000);
      }

      // Spawn objects
      if (!Runner.finished) {
        Runner.spawnTimer++;
        // Spawn every ~40 frames (mix of roses and thorns)
        if (Runner.spawnTimer >= 40) {
          Runner.spawnTimer = 0;
          const lane = Math.floor(Math.random() * 3);
          // 60% roses, 40% thorns
          const type = Math.random() < 0.6 ? 'rose' : 'thorn';
          Runner.objects.push({
            type: type,
            lane: lane,
            z: 1.0,
            collected: false,
            hit: false
          });
          // Sometimes spawn a second object in a different lane
          if (Math.random() < 0.3) {
            let lane2 = (lane + 1 + Math.floor(Math.random() * 2)) % 3;
            const type2 = Math.random() < 0.5 ? 'rose' : 'thorn';
            Runner.objects.push({
              type: type2,
              lane: lane2,
              z: 1.0,
              collected: false,
              hit: false
            });
          }
        }
      }

      // Move objects toward player (z goes from 1.0 down to 0.0)
      Runner.objects.forEach(obj => {
        obj.z -= Runner.speed;
      });

      // Check collisions for objects near the player (z ~ 0.05 to -0.05)
      Runner.objects.forEach(obj => {
        if (obj.z < 0.08 && obj.z > -0.05) {
          if (obj.lane === Runner.lane) {
            if (obj.type === 'rose' && !obj.collected) {
              obj.collected = true;
              Runner.rosesCollected++;
              playSound('collect');
              // Show a rose message
              const msg = roseMessages[Runner.rosesCollected % roseMessages.length];
              showGameMessage(msg);
              // Spawn particles at the object's screen position
              const sx = Runner.vanishX + (Runner.lanePositions[obj.lane] - Runner.vanishX) * (1 - obj.z);
              const sy = Runner.vanishY + (Runner.playerY - Runner.vanishY) * (1 - obj.z);
              spawnParticles(sx, sy, '#E63946', 12);
              spawnParticles(sx, sy, '#FF6B81', 8);
            } else if (obj.type === 'thorn' && !obj.hit) {
              obj.hit = true;
              Runner.stunTimer = 20; // ~20 frames of screen shake
              playSound('jump'); // reuse jump sound as a "ouch" indicator
            }
          }
        }
      });

      // Remove objects that have passed the player
      Runner.objects = Runner.objects.filter(obj => obj.z > -0.3);

      // Grow arch at the end
      if (Runner.finished) {
        Runner.archScale = Math.min(1, Runner.archScale + 0.02);
      }
    }

    function drawRunner() {
      const R = Runner;

      // Screen shake offset
      let shakeX = 0, shakeY = 0;
      if (R.stunTimer > 0) {
        shakeX = (Math.random() - 0.5) * 8;
        shakeY = (Math.random() - 0.5) * 8;
      }

      ctx.save();
      ctx.translate(shakeX, shakeY);

      // Draw background image (fills the entire canvas)
      if (gardenBgImg.complete && gardenBgImg.naturalWidth > 0) {
        ctx.drawImage(gardenBgImg, 0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      } else {
        // Fallback gradient if image not loaded
        const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
        grad.addColorStop(0, '#87CEEB');
        grad.addColorStop(0.5, '#90EE90');
        grad.addColorStop(1, '#7BC96F');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      }

      // Draw perspective lane lines (converging to vanish point)
      ctx.strokeStyle = 'rgba(139, 90, 43, 0.35)';
      ctx.lineWidth = 2;
      // Left edge, left-center divider, right-center divider, right edge
      const laneEdges = [220, 340, 460, 580];
      laneEdges.forEach(bx => {
        ctx.beginPath();
        ctx.moveTo(R.vanishX, R.vanishY);
        ctx.lineTo(bx, CANVAS_HEIGHT);
        ctx.stroke();
      });

      // Draw objects (sorted by z so far objects render first)
      const sortedObjects = [...R.objects].sort((a, b) => b.z - a.z);
      sortedObjects.forEach(obj => {
        if (obj.collected || obj.z > 1.0 || obj.z < -0.1) return;

        const t = 1 - obj.z; // 0 at vanish, 1 at player
        const laneBottomX = R.lanePositions[obj.lane];
        const sx = R.vanishX + (laneBottomX - R.vanishX) * t;
        const sy = R.vanishY + (R.playerY - R.vanishY) * t;
        const scale = 0.2 + 0.9 * t;

        if (obj.type === 'rose') {
          // Draw pixel-art rose
          const roseSize = 26 * scale;
          // Stem
          ctx.fillStyle = '#2D6A2D';
          ctx.fillRect(sx - 1.5 * scale, sy - roseSize * 0.3, 3 * scale, roseSize * 1.2);
          // Leaf
          ctx.fillStyle = '#3A8C3A';
          ctx.beginPath();
          ctx.ellipse(sx + 4 * scale, sy + roseSize * 0.2, 5 * scale, 2.5 * scale, 0.5, 0, Math.PI * 2);
          ctx.fill();
          // Bloom outer petals
          ctx.fillStyle = '#C1272D';
          ctx.beginPath();
          ctx.arc(sx - 3 * scale, sy - roseSize * 0.4, 5 * scale, 0, Math.PI * 2);
          ctx.arc(sx + 3 * scale, sy - roseSize * 0.4, 5 * scale, 0, Math.PI * 2);
          ctx.arc(sx, sy - roseSize * 0.6, 5 * scale, 0, Math.PI * 2);
          ctx.arc(sx, sy - roseSize * 0.25, 4 * scale, 0, Math.PI * 2);
          ctx.fill();
          // Inner bloom
          ctx.fillStyle = '#E63946';
          ctx.beginPath();
          ctx.arc(sx, sy - roseSize * 0.4, 3 * scale, 0, Math.PI * 2);
          ctx.fill();
          // Glow
          ctx.shadowColor = '#FF6B81';
          ctx.shadowBlur = 6 * scale;
          ctx.beginPath();
          ctx.arc(sx, sy - roseSize * 0.4, 2 * scale, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
        } else if (obj.type === 'thorn') {
          // Draw thorn from image
          const ts = 50 * scale;
          if (thornImg.complete && thornImg.naturalWidth > 0) {
            ctx.drawImage(thornImg, sx - ts / 2, sy - ts, ts, ts);
          } else {
            // Fallback: simple red X
            ctx.strokeStyle = '#FF4444';
            ctx.lineWidth = 3 * scale;
            ctx.beginPath();
            ctx.moveTo(sx - 8 * scale, sy - 20 * scale);
            ctx.lineTo(sx + 8 * scale, sy);
            ctx.moveTo(sx + 8 * scale, sy - 20 * scale);
            ctx.lineTo(sx - 8 * scale, sy);
            ctx.stroke();
          }
        }
      });

      // Draw player character at the bottom
      const px = R.laneX;
      const py = R.playerY;
      const bobble = Math.sin(R.runFrame * 0.15) * 2;

      // Body
      ctx.fillStyle = '#4A90D9';
      ctx.fillRect(px - 12, py - 24 + bobble, 24, 20);
      // Head
      ctx.fillStyle = '#FFD5B5';
      ctx.fillRect(px - 10, py - 38 + bobble, 20, 14);
      // Eyes
      ctx.fillStyle = '#333';
      ctx.fillRect(px - 6, py - 34 + bobble, 4, 4);
      ctx.fillRect(px + 2, py - 34 + bobble, 4, 4);
      // Smile
      ctx.fillRect(px - 4, py - 28 + bobble, 8, 2);
      // Legs (running animation)
      ctx.fillStyle = '#333';
      const legAnim = Math.sin(R.runFrame * 0.2) * 4;
      ctx.fillRect(px - 8, py - 4 + bobble, 6, 6 + legAnim);
      ctx.fillRect(px + 2, py - 4 + bobble, 6, 6 - legAnim);

      // Stun flash overlay
      if (R.stunTimer > 0 && R.stunTimer % 4 < 2) {
        ctx.fillStyle = 'rgba(255, 0, 0, 0.15)';
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      }

      // HUD: Rose counter (top-left)
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(10, 10, 140, 35);
      ctx.strokeStyle = '#FF6B9D';
      ctx.lineWidth = 2;
      ctx.strokeRect(10, 10, 140, 35);
      ctx.fillStyle = '#E63946';
      ctx.font = 'bold 18px "Courier New", monospace';
      ctx.fillText('🌹 ' + R.rosesCollected, 20, 33);

      // HUD: Progress bar (top-right)
      const progress = Math.min(R.elapsed / R.duration, 1);
      const barW = 180;
      const barH = 14;
      const barX = CANVAS_WIDTH - barW - 20;
      const barY = 18;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(barX - 4, barY - 4, barW + 8, barH + 8);
      ctx.strokeStyle = '#FF6B9D';
      ctx.strokeRect(barX - 4, barY - 4, barW + 8, barH + 8);
      // Bar background
      ctx.fillStyle = '#333';
      ctx.fillRect(barX, barY, barW, barH);
      // Bar fill
      const barGrad = ctx.createLinearGradient(barX, 0, barX + barW, 0);
      barGrad.addColorStop(0, '#FF6B9D');
      barGrad.addColorStop(1, '#E63946');
      ctx.fillStyle = barGrad;
      ctx.fillRect(barX, barY, barW * progress, barH);
      // Label
      ctx.fillStyle = '#FFF';
      ctx.font = '10px "Courier New", monospace';
      ctx.fillText('Garden Path', barX + barW / 2 - 30, barY + 11);

      // Arch approach animation at the end
      if (R.finished && R.archScale > 0) {
        ctx.globalAlpha = R.archScale;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        
        // Draw a rose arch
        ctx.fillStyle = '#E63946';
        ctx.font = 'bold ' + Math.floor(36 * R.archScale) + 'px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('You made it through the garden!', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 - 20);
        ctx.fillStyle = '#C1272D';
        ctx.font = Math.floor(20 * R.archScale) + 'px "Courier New", monospace';
        ctx.fillText('🌹 ' + R.rosesCollected + ' roses collected 🌹', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 20);
        ctx.textAlign = 'left';
        ctx.globalAlpha = 1;
      }

      // Draw drifting petals overlay (always, for atmosphere)
      const petalColors = ['#FF6B81', '#E63946', '#FF8FA3', '#FF4D6D'];
      for (let i = 0; i < 15; i++) {
        const speed = 1.5 + (i % 4) * 0.5;
        const ppx = CANVAS_WIDTH - ((i * 97 + Date.now() / (10 / speed)) % (CANVAS_WIDTH + 200)) + 100;
        const ppy = (i * 41 + Math.sin(Date.now() / 600 + i * 1.7) * 30) % (CANVAS_HEIGHT - 50);
        const rot = Date.now() / 800 + i * 0.7;
        const size = 3 + (i % 3) * 1.2;
        ctx.save();
        ctx.translate(ppx, ppy);
        ctx.rotate(rot);
        ctx.globalAlpha = 0.4 + Math.sin(Date.now() / 500 + i) * 0.2;
        ctx.fillStyle = petalColors[i % petalColors.length];
        ctx.beginPath();
        ctx.ellipse(0, 0, size, size * 0.5, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
      ctx.globalAlpha = 1;

      ctx.restore(); // end shake offset
    }

    function finishRunner() {
      Runner.active = false;
      const level = levels[Game.currentLevel];
      playSound('levelComplete');
      
      if (level.endText) {
        showStory(level.endText, () => {
          loadLevel(Game.currentLevel + 1);
        });
      } else {
        loadLevel(Game.currentLevel + 1);
      }
    }

    // ============================================
    // TEDDY MODE (Teddy Day) - Boss Fight
    // ============================================
    function initTeddy() {
      Teddy.active = true;
      Teddy.health = Teddy.maxHealth;
      Teddy.phase = 'idle';
      Teddy.phaseTimer = 0;
      Teddy.attackTimer = 0;
      Teddy.attackInterval = 100;
      Teddy.projectiles = [];
      Teddy.hitFlash = 0;
      Teddy.defeatTimer = 0;
      Teddy.bounceOffset = 0;
      Teddy.angerLevel = 0;
      Teddy.shakeAmount = 0;
      Teddy.particles = [];
      Teddy.won = false;
      Teddy.winTimer = 0;
      Teddy.confettiParts = [];
      Teddy.x = 580;
      Teddy.y = Teddy.groundY - Teddy.h;
      Teddy.baseY = Teddy.y;
      // Player health
      Teddy.playerHealth = Teddy.playerMaxHealth;
      Teddy.playerHitFlash = 0;
      Teddy.playerInvincible = 0;
      Teddy.playerDead = false;
      Teddy.deathTimer = 0;
      // Teddy movement AI
      Teddy.vx = 0;
      Teddy.vy = 0;
      Teddy.moveDir = -1;
      Teddy.moveTimer = 0;
      Teddy.jumpTimer = 0;
      Teddy.jumpCooldown = 0;
      Teddy.teddyGrounded = true;
      
      // Position player on the left
      Game.player.x = 80;
      Game.player.y = Teddy.groundY - Game.player.height;
      Game.player.vx = 0;
      Game.player.vy = 0;
      Game.player.grounded = true;
      Game.camera.x = 0;
    }

    function updateTeddy() {
      if (!Teddy.active) return;
      
      // Win animation
      if (Teddy.won) {
        Teddy.winTimer++;
        // Spawn confetti
        if (Teddy.winTimer % 3 === 0 && Teddy.confettiParts.length < 80) {
          Teddy.confettiParts.push({
            x: Math.random() * CANVAS_WIDTH,
            y: -10,
            vx: (Math.random() - 0.5) * 3,
            vy: Math.random() * 2 + 1,
            size: 4 + Math.random() * 4,
            color: ['#FF6B9D', '#FFD700', '#FF69B4', '#87CEEB', '#FFB6C1', '#DDA0DD'][Math.floor(Math.random() * 6)],
            rot: Math.random() * Math.PI * 2,
            rotSpeed: (Math.random() - 0.5) * 0.2
          });
        }
        Teddy.confettiParts.forEach(c => {
          c.x += c.vx;
          c.y += c.vy;
          c.rot += c.rotSpeed;
        });
        Teddy.confettiParts = Teddy.confettiParts.filter(c => c.y < CANVAS_HEIGHT + 20);
        
        // After 4 seconds, advance to teddy victory screen
        if (Teddy.winTimer > 240) {
          Teddy.active = false;
          showTeddyVictory();
        }
        return;
      }
      
      // Player dead - wait for respawn
      if (Teddy.playerDead) {
        Teddy.deathTimer++;
        return;
      }
      
      const p = Game.player;
      
      // Decrease player invincibility frames
      if (Teddy.playerInvincible > 0) Teddy.playerInvincible--;
      if (Teddy.playerHitFlash > 0) Teddy.playerHitFlash--;
      
      // Player movement
      if (Game.keys.left) p.vx = -MOVE_SPEED;
      else if (Game.keys.right) p.vx = MOVE_SPEED;
      else p.vx *= 0.7;
      
      // Jump
      if (Game.keys.jump && p.grounded) {
        p.vy = JUMP_STRENGTH;
        p.grounded = false;
        playSound('jump');
        Game.keys.jump = false;
      }
      
      // Gravity
      p.vy += GRAVITY;
      p.x += p.vx;
      p.y += p.vy;
      
      // Ground collision for player
      if (p.y + p.height >= Teddy.groundY) {
        p.y = Teddy.groundY - p.height;
        p.vy = 0;
        p.grounded = true;
      }
      
      // Keep player in bounds
      if (p.x < 0) p.x = 0;
      if (p.x + p.width > CANVAS_WIDTH) p.x = CANVAS_WIDTH - p.width;
      
      // ============================================
      // TEDDY MOVEMENT AI
      // ============================================
      
      // Decrease hit flash and shake
      if (Teddy.hitFlash > 0) Teddy.hitFlash--;
      if (Teddy.shakeAmount > 0) Teddy.shakeAmount *= 0.9;
      
      // Anger level based on missing health
      Teddy.angerLevel = (Teddy.maxHealth - Teddy.health) / Teddy.maxHealth;
      
      // Teddy gravity
      if (!Teddy.teddyGrounded) {
        Teddy.vy += GRAVITY * 0.8; // slightly floatier than player
      }
      
      // Teddy movement - chase player with some AI personality
      const teddyMoveSpeed = 0.9 + Teddy.angerLevel * 0.9; // gets faster when angry (0.9 - 1.8)
      const teddyCenterX = Teddy.x + Teddy.w / 2;
      const playerCenterX = p.x + p.width / 2;
      const distToPlayer = Math.abs(teddyCenterX - playerCenterX);
      
      if (Teddy.phase !== 'stunned' && Teddy.phase !== 'defeated') {
        Teddy.moveTimer++;
        
        // Chase player - move toward them but not perfectly (oscillate a bit)
        if (distToPlayer > 60) {
          // Move toward player
          Teddy.moveDir = playerCenterX < teddyCenterX ? -1 : 1;
          Teddy.vx = Teddy.moveDir * teddyMoveSpeed;
        } else if (distToPlayer < 40) {
          // Too close, back off slightly
          Teddy.moveDir = playerCenterX < teddyCenterX ? 1 : -1;
          Teddy.vx = Teddy.moveDir * teddyMoveSpeed * 0.5;
        } else {
          // In comfortable range, slow down
          Teddy.vx *= 0.85;
        }
        
        // Add a little random jitter to movement every 60 frames
        if (Teddy.moveTimer % 60 === 0) {
          Teddy.vx += (Math.random() - 0.5) * 2;
        }
        
        // TEDDY JUMPING
        if (Teddy.jumpCooldown > 0) Teddy.jumpCooldown--;
        Teddy.jumpTimer++;
        
        // Jump conditions:
        // 1) Player is above teddy (trying to stomp) - dodge jump
        // 2) Random periodic jumps that increase with anger
        const playerAbove = p.y + p.height < Teddy.y && distToPlayer < 120;
        const randomJumpChance = Teddy.jumpTimer > (160 - Teddy.angerLevel * 40) && Math.random() < 0.02;
        
        if (Teddy.teddyGrounded && Teddy.jumpCooldown <= 0 && (playerAbove || randomJumpChance)) {
          // Jump! Strength depends on whether dodging or random
          const jumpPower = playerAbove ? -9 : -7;
          Teddy.vy = jumpPower;
          Teddy.teddyGrounded = false;
          Teddy.jumpCooldown = 60; // can't jump again for 1 second
          Teddy.jumpTimer = 0;
          
          // If dodging a stomp, also move sideways away from player
          if (playerAbove) {
            Teddy.vx = (playerCenterX < teddyCenterX ? 1 : -1) * 3.5;
          }
        }
      } else if (Teddy.phase === 'stunned') {
        // Stunned - slide to a stop
        Teddy.vx *= 0.9;
      }
      
      // Apply teddy velocity
      Teddy.x += Teddy.vx;
      Teddy.y += Teddy.vy;
      
      // Teddy ground collision
      if (Teddy.y + Teddy.h >= Teddy.groundY) {
        Teddy.y = Teddy.groundY - Teddy.h;
        Teddy.vy = 0;
        Teddy.teddyGrounded = true;
      }
      
      // Keep teddy in bounds
      if (Teddy.x < 0) { Teddy.x = 0; Teddy.vx = 0; }
      if (Teddy.x + Teddy.w > CANVAS_WIDTH) { Teddy.x = CANVAS_WIDTH - Teddy.w; Teddy.vx = 0; }
      
      // Update baseY to follow actual position (for bounce animation)
      Teddy.baseY = Teddy.y;
      
      // Bounce animation only when grounded
      if (Teddy.teddyGrounded && Teddy.phase !== 'stunned') {
        Teddy.bounceOffset = Math.sin(Date.now() * Teddy.bounceSpeed) * 3;
      } else {
        Teddy.bounceOffset = 0;
      }
      
      // ============================================
      // BOSS AI PHASES
      // ============================================
      switch (Teddy.phase) {
        case 'idle':
          Teddy.attackTimer++;
          // Attack interval decreases with anger
           const interval = Teddy.attackInterval - Teddy.angerLevel * 30;
          if (Teddy.attackTimer >= interval) {
            Teddy.phase = 'charging';
            Teddy.phaseTimer = 0;
          }
          break;
          
        case 'charging':
          Teddy.phaseTimer++;
          Teddy.shakeAmount = 3;
          // Slow down while charging
          Teddy.vx *= 0.95;
          // Telegraph for 40 frames then throw
          if (Teddy.phaseTimer >= 40) {
            Teddy.phase = 'throwing';
            Teddy.phaseTimer = 0;
          }
          break;
          
        case 'throwing':
          // Launch projectile(s)
          const numProjectiles = Teddy.angerLevel > 0.5 ? 3 : (Teddy.angerLevel > 0.2 ? 2 : 1);
          for (let i = 0; i < numProjectiles; i++) {
            // Aim directly at player's center mass
            const targetX = p.x + p.width / 2;
            const targetY = p.y + p.height / 2;
            const originX = Teddy.x + (playerCenterX < teddyCenterX ? 0 : Teddy.w); // throw from correct side
            const originY = Teddy.y + Teddy.h / 3;
            const dx = targetX - originX;
            const dy = targetY - originY;
            const dist = Math.sqrt(dx * dx + dy * dy);
            const speed = 3.5 + Teddy.angerLevel * 2;
            // Normalize direction and apply speed
            const dirX = dx / dist;
            const dirY = dy / dist;
            // Add spread for multiple projectiles
            const spread = i === 0 ? 0 : (i === 1 ? 0.25 : -0.25);
            const cosS = Math.cos(spread);
            const sinS = Math.sin(spread);
            Teddy.projectiles.push({
              x: originX,
              y: originY,
              vx: (dirX * cosS - dirY * sinS) * speed,
              vy: (dirX * sinS + dirY * cosS) * speed,
              size: 15,
              rotation: 0
            });
          }
          playSound('teddyThrow');
          Teddy.phase = 'idle';
          Teddy.attackTimer = 0;
          break;
          
        case 'stunned':
          Teddy.phaseTimer++;
          if (Teddy.phaseTimer >= Teddy.stunDuration) {
            Teddy.phase = 'idle';
            Teddy.attackTimer = 0;
          }
          break;
      }
      
      // Update projectiles
      Teddy.projectiles.forEach(proj => {
        proj.x += proj.vx;
        proj.y += proj.vy;
        proj.rotation += 0.15;
      });
      // Remove off-screen projectiles
      Teddy.projectiles = Teddy.projectiles.filter(proj =>
        proj.x > -30 && proj.x < CANVAS_WIDTH + 30 &&
        proj.y > -30 && proj.y < CANVAS_HEIGHT + 30
      );
      
      // ============================================
      // PLAYER-PROJECTILE COLLISION (deals damage)
      // ============================================
      Teddy.projectiles = Teddy.projectiles.filter(proj => {
        if (p.x + p.width > proj.x - proj.size && p.x < proj.x + proj.size &&
            p.y + p.height > proj.y - proj.size && p.y < proj.y + proj.size) {
          // Knockback player
          p.vx = proj.vx > 0 ? 5 : -5;
          p.vy = -6;
          p.grounded = false;
          
          // Deal damage if not invincible
          if (Teddy.playerInvincible <= 0) {
            Teddy.playerHealth--;
            Teddy.playerHitFlash = 20;
            Teddy.playerInvincible = 60; // 1 second of i-frames
            Teddy.shakeAmount = 5;
            playSound('playerHurt');
            
            // Check for player death
            if (Teddy.playerHealth <= 0) {
              Teddy.playerDead = true;
              Teddy.deathTimer = 0;
            }
          }
          
          // Spawn hit particles
          for (let i = 0; i < 8; i++) {
            Teddy.particles.push({
              x: proj.x, y: proj.y,
              vx: (Math.random() - 0.5) * 4,
              vy: (Math.random() - 0.5) * 4,
              life: 1,
              color: '#FF6B9D'
            });
          }
          return false; // remove projectile
        }
        return true;
      });
      
      // ============================================
      // BODY COLLISION - side contact hurts player
      // ============================================
      if (Teddy.phase !== 'defeated' && Teddy.health > 0) {
        if (p.x + p.width > Teddy.x + 15 && p.x < Teddy.x + Teddy.w - 15 &&
            p.y + p.height > Teddy.y + Teddy.h / 2 && p.y < Teddy.y + Teddy.h) {
          // Push away from center
          if (p.x + p.width / 2 < Teddy.x + Teddy.w / 2) {
            p.x = Teddy.x + 15 - p.width;
            p.vx = -4;
          } else {
            p.x = Teddy.x + Teddy.w - 15;
            p.vx = 4;
          }
          p.vy = -5;
          p.grounded = false;
          
          // Deal damage on body contact
          if (Teddy.playerInvincible <= 0) {
            Teddy.playerHealth--;
            Teddy.playerHitFlash = 20;
            Teddy.playerInvincible = 60;
            playSound('playerHurt');
            
            if (Teddy.playerHealth <= 0) {
              Teddy.playerDead = true;
              Teddy.deathTimer = 0;
            }
          }
        }
      }
      
      // ============================================
      // PLAYER STOMPING TEDDY'S HEAD
      // ============================================
      if (Teddy.phase !== 'stunned' && Teddy.health > 0) {
        if (p.vy > 0 &&
            p.x + p.width > Teddy.x + 10 && p.x < Teddy.x + Teddy.w - 10 &&
            p.y + p.height > Teddy.y && p.y + p.height < Teddy.y + Teddy.h / 2 + 10) {
          // Successful stomp!
          Teddy.health--;
          Teddy.hitFlash = 15;
          Teddy.shakeAmount = 8;
          Teddy.phase = 'stunned';
          Teddy.phaseTimer = 0;
          Teddy.projectiles = []; // clear projectiles on hit
          Teddy.vx = 0; // stop teddy movement during stun
          
          // Bounce player up
          p.vy = JUMP_STRENGTH * 0.8;
          p.grounded = false;
          
          playSound('teddyHit');
          
          // Spawn hit particles
          for (let i = 0; i < 15; i++) {
            Teddy.particles.push({
              x: Teddy.x + Teddy.w / 2,
              y: Teddy.y,
              vx: (Math.random() - 0.5) * 6,
              vy: -Math.random() * 5,
              life: 1,
              color: ['#FFD700', '#FF6B9D', '#FFB6C1'][Math.floor(Math.random() * 3)]
            });
          }
          
          // Check for defeat
          if (Teddy.health <= 0) {
            Teddy.phase = 'defeated';
            Teddy.defeatTimer = 0;
            Teddy.won = true;
            Teddy.winTimer = 0;
            playSound('victory');
          }
        }
      }
      
      // Update particles
      Teddy.particles = Teddy.particles.filter(part => {
        part.x += part.vx;
        part.y += part.vy;
        part.vy += 0.1;
        part.life -= 0.025;
        return part.life > 0;
      });
    }

    function drawTeddy() {
      if (!Teddy.active) return;
      
      const shakeX = (Math.random() - 0.5) * Teddy.shakeAmount;
      const shakeY = (Math.random() - 0.5) * Teddy.shakeAmount;
      
      ctx.save();
      ctx.translate(shakeX, shakeY);
      
      // === COZY BEDROOM BACKGROUND ===
      if (teddyBgImg.complete && teddyBgImg.naturalWidth > 0) {
        ctx.drawImage(teddyBgImg, 0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      } else {
        // Fallback gradient if image hasn't loaded
        const wallGrad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
        wallGrad.addColorStop(0, '#FFF5E6');
        wallGrad.addColorStop(1, '#FFE4C4');
        ctx.fillStyle = wallGrad;
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      }
      
      // Floor line
      ctx.strokeStyle = '#8B6543';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, Teddy.groundY);
      ctx.lineTo(CANVAS_WIDTH, Teddy.groundY);
      ctx.stroke();
      
      // === DRAW TEDDY BEAR ===
      // Flip teddy to face movement direction
      const teddyFacing = Game.player.x + Game.player.width / 2 < Teddy.x + Teddy.w / 2 ? -1 : 1;
      ctx.save();
      ctx.translate(Teddy.x + Teddy.w / 2, 0);
      ctx.scale(teddyFacing, 1);
      drawTeddyBear(-Teddy.w / 2, Teddy.y + Teddy.bounceOffset, Teddy.w, Teddy.h);
      ctx.restore();
      
      // === TEDDY HEALTH BAR (above teddy) ===
      const barW = 80;
      const barH = 10;
      const barX = Teddy.x + Teddy.w / 2 - barW / 2;
      const barY = Teddy.y + Teddy.bounceOffset - 25;
      // Background
      ctx.fillStyle = '#333';
      ctx.fillRect(barX, barY, barW, barH);
      // Health fill
      const healthPct = Teddy.health / Teddy.maxHealth;
      const healthColor = healthPct > 0.5 ? '#FF69B4' : healthPct > 0.25 ? '#FF8C00' : '#FF0000';
      ctx.fillStyle = healthColor;
      ctx.fillRect(barX + 1, barY + 1, (barW - 2) * healthPct, barH - 2);
      // Border
      ctx.strokeStyle = '#FFF';
      ctx.lineWidth = 1;
      ctx.strokeRect(barX, barY, barW, barH);
      // Label
      ctx.fillStyle = '#FFF';
      ctx.font = '9px "Courier New", monospace';
      ctx.textAlign = 'center';
      ctx.fillText('TEDDY', Teddy.x + Teddy.w / 2, barY - 3);
      ctx.textAlign = 'left';
      
      // === DRAW PROJECTILES (flying hearts) ===
      Teddy.projectiles.forEach(proj => {
        ctx.save();
        ctx.translate(proj.x, proj.y);
        ctx.rotate(proj.rotation);
        ctx.fillStyle = '#FF1493';
        drawHeart(0, 0, proj.size);
        ctx.restore();
      });
      
      // === DRAW PLAYER (with blinking during i-frames) ===
      if (!Teddy.playerDead) {
        // Blink player during invincibility
        const shouldDrawPlayer = Teddy.playerInvincible <= 0 || Math.floor(Teddy.playerInvincible / 3) % 2 === 0;
        if (shouldDrawPlayer) {
          // Tint player red during hit flash
          if (Teddy.playerHitFlash > 0) {
            ctx.globalAlpha = 0.7;
          }
          drawPlayer();
          ctx.globalAlpha = 1;
        }
      }
      
      // === PLAYER HEALTH BAR (top-left HUD) ===
      const pBarX = 15;
      const pBarY = 15;
      const pBarW = 120;
      const pBarH = 14;
      // Background
      ctx.fillStyle = 'rgba(0, 0, 0, 0.5)';
      ctx.fillRect(pBarX - 2, pBarY - 2, pBarW + 4, pBarH + 4);
      ctx.fillStyle = '#333';
      ctx.fillRect(pBarX, pBarY, pBarW, pBarH);
      // Health fill
      const pHealthPct = Teddy.playerHealth / Teddy.playerMaxHealth;
      const pHealthColor = pHealthPct > 0.5 ? '#4CAF50' : pHealthPct > 0.25 ? '#FF8C00' : '#FF0000';
      ctx.fillStyle = pHealthColor;
      ctx.fillRect(pBarX + 1, pBarY + 1, (pBarW - 2) * pHealthPct, pBarH - 2);
      // Border
      ctx.strokeStyle = '#FFF';
      ctx.lineWidth = 1;
      ctx.strokeRect(pBarX, pBarY, pBarW, pBarH);
      // Label
      ctx.fillStyle = '#FFF';
      ctx.font = 'bold 10px "Courier New", monospace';
      ctx.fillText('HP', pBarX + 4, pBarY + 11);
      // Heart icons for remaining lives
      for (let i = 0; i < Teddy.playerMaxHealth; i++) {
        ctx.fillStyle = i < Teddy.playerHealth ? '#FF1493' : '#555';
        drawHeart(pBarX + pBarW + 15 + i * 18, pBarY + pBarH / 2 - 1, 6);
      }
      
      // === DRAW PARTICLES ===
      Teddy.particles.forEach(part => {
        ctx.globalAlpha = part.life;
        ctx.fillStyle = part.color;
        ctx.fillRect(part.x - 2, part.y - 2, 4, 4);
      });
      ctx.globalAlpha = 1;
      
      // === WIN ANIMATION ===
      if (Teddy.won) {
        // Confetti
        Teddy.confettiParts.forEach(c => {
          ctx.save();
          ctx.translate(c.x, c.y);
          ctx.rotate(c.rot);
          ctx.fillStyle = c.color;
          ctx.fillRect(-c.size / 2, -c.size / 4, c.size, c.size / 2);
          ctx.restore();
        });
        
        // "You defeated the teddy!" text
        ctx.fillStyle = '#FFF';
        ctx.font = 'bold 28px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.strokeStyle = '#FF6B9D';
        ctx.lineWidth = 3;
        ctx.strokeText('Teddy defeated!', CANVAS_WIDTH / 2, 80);
        ctx.fillText('Teddy defeated!', CANVAS_WIDTH / 2, 80);
        ctx.textAlign = 'left';
      }
      
      // === GAME OVER OVERLAY ===
      if (Teddy.playerDead) {
        // Dark overlay
        ctx.fillStyle = 'rgba(0, 0, 0, 0.6)';
        ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
        
        // Broken heart
        ctx.fillStyle = '#FF1493';
        drawHeart(CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 - 60, 30);
        // Crack line through the heart
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(CANVAS_WIDTH / 2 - 2, CANVAS_HEIGHT / 2 - 85);
        ctx.lineTo(CANVAS_WIDTH / 2 + 5, CANVAS_HEIGHT / 2 - 65);
        ctx.lineTo(CANVAS_WIDTH / 2 - 5, CANVAS_HEIGHT / 2 - 50);
        ctx.lineTo(CANVAS_WIDTH / 2 + 2, CANVAS_HEIGHT / 2 - 35);
        ctx.stroke();
        
        // Text
        ctx.fillStyle = '#FF6B9D';
        ctx.font = 'bold 32px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Game Over', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 10);
        
        ctx.fillStyle = '#FFB6C1';
        ctx.font = '16px "Courier New", monospace';
        ctx.fillText('The teddy wins this round...', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 40);
        
        // "Try Again" prompt (appears after 1 second)
        if (Teddy.deathTimer > 60) {
          const blinkAlpha = Math.sin(Date.now() * 0.005) * 0.3 + 0.7;
          ctx.globalAlpha = blinkAlpha;
          ctx.fillStyle = '#FFF';
          ctx.font = 'bold 18px "Courier New", monospace';
          ctx.fillText('Press SPACE or ENTER to try again', CANVAS_WIDTH / 2, CANVAS_HEIGHT / 2 + 80);
          ctx.globalAlpha = 1;
        }
        ctx.textAlign = 'left';
      }
      
      // === BOSS PHASE INDICATORS ===
      if (Teddy.phase === 'charging' && !Teddy.won && !Teddy.playerDead) {
        // Warning indicator above teddy
        ctx.fillStyle = '#FF0000';
        ctx.font = 'bold 24px "Courier New", monospace';
        ctx.textAlign = 'center';
        const warningAlpha = Math.sin(Date.now() * 0.01) * 0.5 + 0.5;
        ctx.globalAlpha = warningAlpha;
        ctx.fillText('!', Teddy.x + Teddy.w / 2, Teddy.y + Teddy.bounceOffset - 35);
        ctx.globalAlpha = 1;
        ctx.textAlign = 'left';
      }
      
      if (Teddy.phase === 'stunned' && !Teddy.won) {
        // Stars around teddy head when stunned
        for (let i = 0; i < 3; i++) {
          const angle = Date.now() * 0.005 + i * (Math.PI * 2 / 3);
          const starX = Teddy.x + Teddy.w / 2 + Math.cos(angle) * 40;
          const starY = Teddy.y + Teddy.bounceOffset - 10 + Math.sin(angle) * 15;
          ctx.fillStyle = '#FFD700';
          ctx.font = '16px Arial';
          ctx.fillText('\u2605', starX, starY);
        }
      }
      
      // Hint text at start
      if (!Teddy.won && !Teddy.playerDead && Teddy.health === Teddy.maxHealth && Date.now() % 3000 < 2000) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
        ctx.font = '14px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Jump on the teddy\'s head! Watch your HP!', CANVAS_WIDTH / 2, 45);
        ctx.textAlign = 'left';
      }
      
      ctx.restore(); // end shake offset
    }

    function drawTeddyBear(x, y, w, h) {
      // Flash white when hit
      const isFlashing = Teddy.hitFlash > 0 && Teddy.hitFlash % 4 < 2;
      
      // Colors
      const bodyColor = isFlashing ? '#FFFFFF' : '#FF69B4';
      const bellyColor = isFlashing ? '#FFFFFF' : '#FFB6C1';
      const earInner = isFlashing ? '#FFFFFF' : '#FF1493';
      const noseColor = isFlashing ? '#FFFFFF' : '#C71585';
      const bowColor = isFlashing ? '#FFFFFF' : '#FF0000';
      
      // Defeated teddy falls over
      if (Teddy.won) {
        ctx.save();
        ctx.translate(x + w / 2, y + h);
        const fallAngle = Math.min(Teddy.winTimer * 0.02, Math.PI / 6);
        ctx.rotate(fallAngle);
        ctx.translate(-(x + w / 2), -(y + h));
      }
      
      // Ears (behind head)
      ctx.fillStyle = bodyColor;
      // Left ear
      ctx.beginPath();
      ctx.arc(x + w * 0.2, y + 8, 18, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = earInner;
      ctx.beginPath();
      ctx.arc(x + w * 0.2, y + 8, 10, 0, Math.PI * 2);
      ctx.fill();
      // Right ear
      ctx.fillStyle = bodyColor;
      ctx.beginPath();
      ctx.arc(x + w * 0.8, y + 8, 18, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = earInner;
      ctx.beginPath();
      ctx.arc(x + w * 0.8, y + 8, 10, 0, Math.PI * 2);
      ctx.fill();
      
      // Head
      ctx.fillStyle = bodyColor;
      ctx.beginPath();
      ctx.arc(x + w / 2, y + 25, 30, 0, Math.PI * 2);
      ctx.fill();
      
      // Body
      ctx.fillStyle = bodyColor;
      ctx.beginPath();
      ctx.ellipse(x + w / 2, y + h * 0.6, w * 0.4, h * 0.35, 0, 0, Math.PI * 2);
      ctx.fill();
      
      // Belly
      ctx.fillStyle = bellyColor;
      ctx.beginPath();
      ctx.ellipse(x + w / 2, y + h * 0.6, w * 0.25, h * 0.22, 0, 0, Math.PI * 2);
      ctx.fill();
      
      // Heart on belly
      if (!isFlashing) {
        ctx.fillStyle = '#FF1493';
        drawHeart(x + w / 2, y + h * 0.55, 10);
      }
      
      // Arms
      ctx.fillStyle = bodyColor;
      // Left arm
      const armWave = Teddy.phase === 'charging' ? Math.sin(Date.now() * 0.02) * 15 : 0;
      ctx.beginPath();
      ctx.ellipse(x + 5, y + h * 0.5 + armWave, 12, 22, -0.3, 0, Math.PI * 2);
      ctx.fill();
      // Right arm
      ctx.beginPath();
      ctx.ellipse(x + w - 5, y + h * 0.5 - armWave, 12, 22, 0.3, 0, Math.PI * 2);
      ctx.fill();
      
      // Legs
      ctx.fillStyle = bodyColor;
      ctx.beginPath();
      ctx.ellipse(x + w * 0.3, y + h - 10, 14, 12, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse(x + w * 0.7, y + h - 10, 14, 12, 0, 0, Math.PI * 2);
      ctx.fill();
      
      // Foot pads
      ctx.fillStyle = bellyColor;
      ctx.beginPath();
      ctx.ellipse(x + w * 0.3, y + h - 8, 8, 7, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse(x + w * 0.7, y + h - 8, 8, 7, 0, 0, Math.PI * 2);
      ctx.fill();
      
      // Eyes
      if (!isFlashing) {
        if (Teddy.phase === 'stunned' || Teddy.won) {
          // Dizzy X eyes
          ctx.strokeStyle = '#333';
          ctx.lineWidth = 2;
          // Left eye X
          ctx.beginPath();
          ctx.moveTo(x + w * 0.35 - 5, y + 18);
          ctx.lineTo(x + w * 0.35 + 5, y + 28);
          ctx.moveTo(x + w * 0.35 + 5, y + 18);
          ctx.lineTo(x + w * 0.35 - 5, y + 28);
          ctx.stroke();
          // Right eye X
          ctx.beginPath();
          ctx.moveTo(x + w * 0.65 - 5, y + 18);
          ctx.lineTo(x + w * 0.65 + 5, y + 28);
          ctx.moveTo(x + w * 0.65 + 5, y + 18);
          ctx.lineTo(x + w * 0.65 - 5, y + 28);
          ctx.stroke();
        } else {
          // Normal eyes - get angrier as health drops
          ctx.fillStyle = '#333';
          ctx.beginPath();
          ctx.arc(x + w * 0.35, y + 23, 5, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(x + w * 0.65, y + 23, 5, 0, Math.PI * 2);
          ctx.fill();
          // Eye shine
          ctx.fillStyle = '#FFF';
          ctx.beginPath();
          ctx.arc(x + w * 0.35 + 2, y + 21, 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(x + w * 0.65 + 2, y + 21, 2, 0, Math.PI * 2);
          ctx.fill();
          // Angry eyebrows when damaged
          if (Teddy.angerLevel > 0) {
            ctx.strokeStyle = '#333';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(x + w * 0.25, y + 14 - Teddy.angerLevel * 4);
            ctx.lineTo(x + w * 0.42, y + 16);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(x + w * 0.75, y + 14 - Teddy.angerLevel * 4);
            ctx.lineTo(x + w * 0.58, y + 16);
            ctx.stroke();
          }
        }
      }
      
      // Nose (heart-shaped)
      ctx.fillStyle = noseColor;
      drawHeart(x + w / 2, y + 32, 5);
      
      // Mouth
      if (!isFlashing) {
        ctx.strokeStyle = '#C71585';
        ctx.lineWidth = 2;
        if (Teddy.phase === 'stunned' || Teddy.won) {
          // Wobbly mouth
          ctx.beginPath();
          ctx.moveTo(x + w * 0.35, y + 40);
          ctx.bezierCurveTo(x + w * 0.4, y + 43, x + w * 0.5, y + 38, x + w * 0.65, y + 40);
          ctx.stroke();
        } else if (Teddy.angerLevel > 0.3) {
          // Angry frown
          ctx.beginPath();
          ctx.arc(x + w / 2, y + 44, 8, Math.PI * 0.2, Math.PI * 0.8, true);
          ctx.stroke();
        } else {
          // Normal smile
          ctx.beginPath();
          ctx.arc(x + w / 2, y + 36, 8, 0, Math.PI);
          ctx.stroke();
        }
      }
      
      // Bow tie
      ctx.fillStyle = bowColor;
      // Left triangle
      ctx.beginPath();
      ctx.moveTo(x + w / 2, y + 48);
      ctx.lineTo(x + w / 2 - 12, y + 42);
      ctx.lineTo(x + w / 2 - 12, y + 54);
      ctx.closePath();
      ctx.fill();
      // Right triangle
      ctx.beginPath();
      ctx.moveTo(x + w / 2, y + 48);
      ctx.lineTo(x + w / 2 + 12, y + 42);
      ctx.lineTo(x + w / 2 + 12, y + 54);
      ctx.closePath();
      ctx.fill();
      // Center knot
      ctx.beginPath();
      ctx.arc(x + w / 2, y + 48, 4, 0, Math.PI * 2);
      ctx.fill();
      
      if (Teddy.won) {
        ctx.restore();
      }
    }

    // ============================================
    // PHYSICS & COLLISION
    // ============================================
    function updatePlayer() {
      const p = Game.player;
      
      // Horizontal movement
      if (Game.keys.left) {
        p.vx = -MOVE_SPEED;
        p.facing = -1;
      } else if (Game.keys.right) {
        p.vx = MOVE_SPEED;
        p.facing = 1;
      } else {
        p.vx *= 0.8;
      }
      
      // Jump
      if (Game.keys.jump && p.grounded) {
        p.vy = JUMP_STRENGTH;
        p.grounded = false;
        playSound('jump');
        Game.keys.jump = false;
      }
      
      // Gravity
      p.vy += GRAVITY;
      
      // Apply velocity
      p.x += p.vx;
      p.y += p.vy;
      
      // Platform collision
      p.grounded = false;
      Game.platforms.forEach(plat => {
        if (p.x + p.width > plat.x && p.x < plat.x + plat.w) {
          if (p.y + p.height > plat.y && p.y + p.height < plat.y + plat.h + 20 && p.vy > 0) {
            p.y = plat.y - p.height;
            p.vy = 0;
            p.grounded = true;
          }
        }
      });
      
      // Keep in bounds
      if (p.x < 0) p.x = 0;
      
      // Fall death - respawn
      if (p.y > CANVAS_HEIGHT + 100) {
        p.x = 50;
        p.y = levels[Game.currentLevel].groundY - 100;
        p.vx = 0;
        p.vy = 0;
      }
      
      // Camera follow
      const targetCamX = p.x - CANVAS_WIDTH / 3;
      Game.camera.x += (targetCamX - Game.camera.x) * 0.1;
      if (Game.camera.x < 0) Game.camera.x = 0;
      const maxCam = levels[Game.currentLevel].width - CANVAS_WIDTH;
      if (Game.camera.x > maxCam) Game.camera.x = maxCam;
    }

    function checkCollisions() {
      const p = Game.player;
      
      // Heart collection
      Game.hearts.forEach(heart => {
        if (heart.collected) return;
        
        const dx = (p.x + p.width / 2) - heart.x;
        const dy = (p.y + p.height / 2) - heart.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        
        if (dist < 30) {
          heart.collected = true;
          Game.totalHearts++;
          playSound('collect');
          spawnParticles(heart.x, heart.y, '#FF6B9D', 10);
          updateHeartsUI();
        }
      });
      
      // Monster collision (defeats it harmlessly)
      Game.obstacles.forEach(obs => {
        if (obs.type === 'monster' && !obs.defeated) {
          if (p.x + p.width > obs.x && p.x < obs.x + obs.w &&
              p.y + p.height > obs.y && p.y < obs.y + obs.h) {
            obs.defeated = true;
            spawnParticles(obs.x + obs.w / 2, obs.y + obs.h / 2, '#FFD700', 20);
            playSound('collect');
            showGameMessage("Wait... it was never real. Just in my head.");
          }
        }
      });
      
      // Level end
      const level = levels[Game.currentLevel];
      if (p.x > level.endX) {
        if (level.isFinal) {
          showVictory();
        } else {
          playSound('levelComplete');
          if (level.endText) {
            showStory(level.endText, () => {
              loadLevel(Game.currentLevel + 1);
            });
          } else {
            loadLevel(Game.currentLevel + 1);
          }
        }
      }
    }

    function updateHeartsUI() {
      const heartsEl = document.getElementById('hearts-counter');
      heartsEl.innerHTML = '&#10084; '.repeat(Game.totalHearts);
    }

    // ============================================
    // VICTORY & CONFETTI
    // ============================================
    let confettiPieces = [];
    
    // Chocolate grid state for the victory screen
    const chocoReveal = {
      grid: [],       // 4x4 array of {eaten: false}
      cols: 4,
      rows: 4,
      canvas: null,
      ctx: null,
      photoImg: null, // stores the loaded photo for redraws
      imgW: 0,
      imgH: 0
    };

    function showVictory() {
      Game.state = 'victory';
      playSound('victory');
      
      document.getElementById('title-screen').style.display = 'none';
      document.getElementById('level-indicator').style.display = 'none';
      document.getElementById('hearts-counter').style.display = 'none';
      document.getElementById('victory-screen').style.display = 'block';
      document.getElementById('eat-choco-btn').style.display = 'inline-block';
      
      const photoContainer = document.getElementById('valentine-photo');
      photoContainer.innerHTML = '';
      
      const img = new Image();
      img.onload = function() {
        const displayW = 280;
        const displayH = 280;
        
        chocoReveal.imgW = displayW;
        chocoReveal.imgH = displayH;
        
        // Light-pixelate the photo and store it for redraws
        chocoReveal.photoImg = pixelateImage(img, 2);
        
        // Create a single canvas for photo + chocolate overlay
        const cvs = document.createElement('canvas');
        cvs.width = displayW;
        cvs.height = displayH;
        photoContainer.appendChild(cvs);
        
        chocoReveal.canvas = cvs;
        chocoReveal.ctx = cvs.getContext('2d');
        
        // Initialize grid
        chocoReveal.grid = [];
        for (let r = 0; r < chocoReveal.rows; r++) {
          for (let c = 0; c < chocoReveal.cols; c++) {
            chocoReveal.grid.push({ row: r, col: c, eaten: false });
          }
        }
        
        // Draw photo + full chocolate grid on the single canvas
        drawChocoOverlay();
      };
      img.onerror = function() {
        photoContainer.innerHTML = '<div style="font-size: 80px; margin: 20px;">&#x1F49C;</div>';
      };
      img.src = '/valentine/valentine.jpeg';
      
      startConfetti();
    }
    
    function drawChocoOverlay() {
      const c = chocoReveal.ctx;
      const w = chocoReveal.imgW;
      const h = chocoReveal.imgH;
      const sqW = w / chocoReveal.cols;
      const sqH = h / chocoReveal.rows;
      
      // Clear and draw the pixelated photo as base layer
      c.clearRect(0, 0, w, h);
      if (chocoReveal.photoImg) {
        c.drawImage(chocoReveal.photoImg, 0, 0, w, h);
      }
      
      // Draw uneaten chocolate squares on top (hiding the photo underneath)
      chocoReveal.grid.forEach(sq => {
        if (sq.eaten) return;
        
        const x = sq.col * sqW;
        const y = sq.row * sqH;
        
        // Dark chocolate body
        c.fillStyle = '#3B1F0E';
        c.fillRect(x, y, sqW, sqH);
        
        // Inner raised portion (lighter)
        const inset = 4;
        c.fillStyle = '#5C3317';
        c.fillRect(x + inset, y + inset, sqW - inset * 2, sqH - inset * 2);
        
        // Glossy highlight
        const shineGrad = c.createLinearGradient(x, y, x + sqW * 0.5, y + sqH * 0.5);
        shineGrad.addColorStop(0, 'rgba(255, 255, 255, 0.15)');
        shineGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        c.fillStyle = shineGrad;
        c.fillRect(x + inset, y + inset, sqW - inset * 2, sqH - inset * 2);
        
        // Groove lines
        c.strokeStyle = '#2A1508';
        c.lineWidth = 1.5;
        c.strokeRect(x + 0.5, y + 0.5, sqW - 1, sqH - 1);
      });
    }
    
    function eatChocolate() {
      const uneaten = chocoReveal.grid.filter(sq => !sq.eaten);
      if (uneaten.length === 0) return;
      
      // Pick a random uneaten square
      const sq = uneaten[Math.floor(Math.random() * uneaten.length)];
      sq.eaten = true;
      
      // Play bite sound
      playSound('crack');
      
      // Redraw overlay (the eaten square will be skipped, revealing photo)
      drawChocoOverlay();
      
      // Show "ghop ghop" comic text
      const sqW = chocoReveal.imgW / chocoReveal.cols;
      const sqH = chocoReveal.imgH / chocoReveal.rows;
      const photoContainer = document.getElementById('valentine-photo');
      
      const ghop = document.createElement('span');
      ghop.className = 'ghop-text';
      ghop.textContent = 'ghop ghop!';
      // Position near the eaten square with some randomness
      ghop.style.left = (sq.col * sqW + sqW / 2 - 50 + (Math.random() - 0.5) * 20) + 'px';
      ghop.style.top = (sq.row * sqH + sqH / 2 - 15 + (Math.random() - 0.5) * 10) + 'px';
      photoContainer.appendChild(ghop);
      
      // Remove the text after animation
      setTimeout(() => {
        if (ghop.parentNode) ghop.parentNode.removeChild(ghop);
      }, 850);
      
      // Check if all eaten
      const remaining = chocoReveal.grid.filter(sq2 => !sq2.eaten);
      if (remaining.length === 0) {
        // All chocolate eaten - show final message after a short delay
        document.getElementById('eat-choco-btn').style.display = 'none';
        setTimeout(() => {
          showFinalMessage();
        }, 1200);
      }
    }

    function pixelateImage(img, pixelSize) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      
      const w = Math.floor(img.width / pixelSize);
      const h = Math.floor(img.height / pixelSize);
      
      canvas.width = img.width;
      canvas.height = img.height;
      
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(img, 0, 0, w, h);
      ctx.drawImage(canvas, 0, 0, w, h, 0, 0, img.width, img.height);
      
      return canvas;
    }

    function startConfetti() {
      confettiPieces = [];
      for (let i = 0; i < 100; i++) {
        confettiPieces.push({
          x: Math.random() * CANVAS_WIDTH,
          y: Math.random() * -CANVAS_HEIGHT,
          vx: (Math.random() - 0.5) * 4,
          vy: 2 + Math.random() * 3,
          size: 5 + Math.random() * 10,
          color: ['#FF6B9D', '#FFD700', '#FF69B4', '#FFA500', '#FF1493'][Math.floor(Math.random() * 5)],
          rotation: Math.random() * 360,
          rotationSpeed: (Math.random() - 0.5) * 10
        });
      }
    }

    function updateConfetti() {
      confettiCtx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
      
      confettiPieces.forEach(c => {
        c.x += c.vx;
        c.y += c.vy;
        c.rotation += c.rotationSpeed;
        
        if (c.y > CANVAS_HEIGHT) {
          c.y = -20;
          c.x = Math.random() * CANVAS_WIDTH;
        }
        
        confettiCtx.save();
        confettiCtx.translate(c.x, c.y);
        confettiCtx.rotate(c.rotation * Math.PI / 180);
        confettiCtx.fillStyle = c.color;
        confettiCtx.fillRect(-c.size / 2, -c.size / 4, c.size, c.size / 2);
        confettiCtx.restore();
      });
    }

