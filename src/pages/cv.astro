---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const cvEntry = await getEntry('cv', 'cv');
const { Content } = await cvEntry.render();
---

<BaseLayout title="CV - Priyam Gupta" description="Priyam Gupta's curriculum vitae - education, experience, and skills.">
  <article class="cv-page">
    <header class="cv-header">
      <h1>Curriculum Vitae</h1>
    </header>
    
    <div class="cv-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .cv-page {
    padding: var(--space-md) 0;
  }
  
  .cv-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }
  
  .cv-header h1 {
    margin-bottom: 0;
  }
  
  .cv-content {
    line-height: 1.8;
  }
  
  .cv-content :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  
  .cv-content :global(h2:first-child) {
    margin-top: 0;
  }
  
  .cv-content :global(h3) {
    font-size: 1.125rem;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }
  
  .cv-content :global(p) {
    margin-bottom: var(--space-sm);
  }
  
  .cv-content :global(strong) {
    color: var(--color-text);
  }
  
  .cv-content :global(em) {
    color: var(--color-text-muted);
    font-style: italic;
  }
  
  .cv-content :global(ul) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-lg);
  }
  
  .cv-content :global(li) {
    margin-bottom: var(--space-sm);
  }
  
  .cv-content :global(hr) {
    margin: var(--space-2xl) 0;
    border: none;
    border-top: 1px solid var(--color-border);
  }
  
  @media (max-width: 480px) {
    .cv-header h1 {
      font-size: 1.75rem;
    }
    
    .cv-content :global(h2) {
      font-size: 1.25rem;
    }
    
    .cv-content :global(h3) {
      font-size: 1rem;
    }
  }
</style>
